# Chat assistant environment (SDD). Copy relevant vars into the Vercel project env.
# Thresholds deliberately live here and NOT in code — the repo is public (SDD D12).

# --- feature flag ---
# Widget is ON by default (launch decision 26-08). Set to false as the kill switch;
# ?chat=1 still enables it per browser on a switched-off deploy. Build-time vars
# must NOT be "sensitive" on Vercel: CI builds pull sensitive values as empty.
PUBLIC_CHAT_ENABLED=true
# Booking link for the book_meeting card (defaults to the public Google Calendar link).
PUBLIC_CHAT_BOOKING_URL=https://calendar.app.google/GV4mwWWbdzJJJBfW9
# Source chips under answers (on by default; Frans's call, 26-08).
PUBLIC_CHAT_SOURCE_CHIPS=true

# --- model routing (SDD D4) ---
# vertex    = production: Gemini 3.7 Flash on Vertex AI, EU region.
# google    = dev default: SAME model via the Gemini API (AI Studio key, no GCP
#             project). Not EU-guaranteed -> dev only. Use a PAID-tier key
#             (the free tier may use prompts for product improvement).
# anthropic = optional dev fallback (Claude, US inference).
CHAT_MODEL_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Vertex (production):
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=europe-west4
# Service-account JSON, base64-encoded (one line); alternatively use
# GOOGLE_APPLICATION_CREDENTIALS (file path) locally.
GOOGLE_VERTEX_CREDENTIALS_B64=
CHAT_MODEL=gemini-3.7-flash
CHAT_FRONTIER_MODEL=claude-sonnet-5
CHAT_USE_FRONTIER=false
CHAT_THINKING_BUDGET=2048
CHAT_MAX_OUTPUT_TOKENS=1024

# --- guardrails (SDD D9) ---
CHAT_TOKEN_SECRET=            # long random string; REQUIRED in production
CHAT_IP_SALT=                 # long random string; REQUIRED in production
CHAT_SESSION_DAILY_LIMIT=20
CHAT_IP_PER_MINUTE_LIMIT=10
CHAT_MAX_MESSAGES_PER_CONVERSATION=30
# Spend circuit breakers in euro cents (confirmed 2026-08-21: 500/1000/10000).
CHAT_DAILY_ALERT_CENTS=500
CHAT_DAILY_HARD_CENTS=1000
CHAT_MONTHLY_HARD_CENTS=10000

# --- integrations ---
CHAT_SLACK_WEBHOOK_URL=       # escalations + budget alerts
CHAT_SUPABASE_URL=            # https://<project>.supabase.co (EU region!)
CHAT_SUPABASE_SERVICE_KEY=    # service-role key; server-side only

# --- forms + escalation mail (Resend, cutover plan F1) ---
RESEND_API_KEY=               # sending-only key; domain send.aiheroes.io, region eu-west-1
MAIL_FROM=AI Heroes <noreply@send.aiheroes.io>
MAIL_TO=hello@aiheroes.io
