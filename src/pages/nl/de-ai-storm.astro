---
// A1 De AI Storm (docs/relaunch/pages/A1-de-ai-storm.md) in the campaign template. Date on the page is
// the first broadcast, 7 June 2026; the embed is allowed; the item stays in the menu
// (01-besluiten §14). The topic of the episode is still to come from Frans; until then the page
// uses what the broadcast notice said (Jan Brusse on AI adoption in SMEs).
import HsLayout from '../../layouts/HsLayout.astro';
import HsCampaign from '../../components/hs/HsCampaign.astro';
import { CAMPAIGNS } from '../../data/campaigns';

const c = CAMPAIGNS['de-ai-storm'];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Over ons', href: '/nl/over-ons' }];
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: c.media.title,
  description: c.description,
  thumbnailUrl: [`https://i.ytimg.com/vi/${c.media.youtubeId}/maxresdefault.jpg`],
  uploadDate: c.media.uploadDate,
  embedUrl: `https://www.youtube-nocookie.com/embed/${c.media.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${c.media.youtubeId}`,
  publication: { '@type': 'BroadcastEvent', isLiveBroadcast: false, startDate: c.date, publishedOn: { '@type': 'BroadcastService', name: 'RTL 7' } },
  publisher: { '@type': 'Organization', name: 'AI Heroes', url: 'https://aiheroes.io' },
};
---

<HsLayout
  title={c.title}
  seoTitle={c.seoTitle}
  description={c.description}
  ogImage={`https://i.ytimg.com/vi/${c.media.youtubeId}/maxresdefault.jpg`}
  crumbs={crumbs}
  jsonLd={videoSchema}
>
  <HsCampaign campaign={c} crumbs={crumbs} />
</HsLayout>
