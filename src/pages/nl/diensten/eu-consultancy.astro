---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProcessSteps from '../../../components/blocks/ProcessSteps.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import Faq from '../../../components/blocks/Faq.astro';

const options = [
  { id: 'on-premises', title: 'Op eigen servers', accent: 'dark' as const, description: 'Een taalmodel op je eigen hardware. Geen abonnement, geen data die het pand verlaat. Wij installeren, configureren en trainen je beheerders; jij houdt de sleutels.' },
  { id: 'europese-cloud', title: 'Europese cloud', accent: 'blue' as const, description: 'Mistral in Frankrijk, Aleph Alpha in Duitsland, Nederlandse hosting voor de rest. Modellen van Europees niveau, gehost onder Europees recht.' },
  { id: 'migratie', title: 'Migratie weg van Amerikaanse cloud', accent: 'red' as const, description: 'Van ChatGPT, Azure OpenAI of AWS Bedrock naar een Europees alternatief, zonder dat je team er iets van merkt. Inclusief inkoopadvies over leveranciers en contracten.' },
  { id: 'ai-beleid', title: 'AI-beleid en AI Act', accent: 'red' as const, description: 'Classificatie van je systemen onder de AI Act, logging en menselijk toezicht in het ontwerp, en een AI-beleid van twee A4 dat je team ook echt gebruikt.' },
];

const method = [
  { title: 'Startsprint', eyebrow: 'Week 1', body: 'We brengen je digitale omgeving in kaart: welke tools, waar data naartoe gaat, welke leveranciers onder Amerikaanse jurisdictie vallen. Uitkomst: een hostingontwerp, een risicobeoordeling en de business case op één A4.', href: '/nl/startsprint', hrefLabel: 'Meer over de startsprint' },
  { title: 'Bouwen en migreren', eyebrow: 'Week 2 tot 12', body: 'Het model of de toepassing draait op de gekozen plek, gekoppeld aan je systemen. Migratie in fasen, met de oude en nieuwe omgeving naast elkaar tot de cijfers kloppen.' },
  { title: 'Beheer overgedragen', eyebrow: 'Oplevering', body: 'Je beheerders zijn getraind, de documentatie is compleet en de AI Act-classificatie ligt vast. Je kunt het zelf draaiende houden; wij blijven bereikbaar als je dat wilt.' },
];

const stats = [
  { value: '1 week', label: 'tot hostingontwerp en risicobeoordeling' },
  { value: 'EU-recht', label: 'op elke server die je data raakt' },
  { value: 'Eigen stack', label: 'onze assistent op deze site draait Europees' },
];

const proof = [
  { title: 'De assistent op deze site', eyebrow: 'In eigen beheer draaien', accent: 'dark' as const, href: '/nl/cases/eigen-stack', description: 'Door ons gebouwd, gehost in Europa, met Europese database en retentiebeleid. Zelf doen wat we adviseren.' },
];

const related = [
  { title: 'Iets nieuws bouwen', accent: 'red' as const, href: '/nl/diensten/software', description: 'Een assistent, een werkstroom, een tool die er nog niet is.' },
  { title: 'Vervangen wat niet meer voldoet', accent: 'blue' as const, href: '/nl/diensten/software-vervangen', description: 'Verouderde of te dure software eruit, iets dat past ervoor in de plaats.' },
];

const faq = [
  { q: 'Zijn Europese modellen goed genoeg?', a: 'Voor de meeste bedrijfstoepassingen wel: documenten samenvatten, vragen beantwoorden op eigen data, teksten opstellen, spraak verwerken. In de startsprint testen we het op jouw situatie, zodat je het niet hoeft te geloven maar kunt zien.' },
  { q: 'Wat kost een eigen server?', a: 'Dat hangt af van het model en het aantal gebruikers. Een middelgrote organisatie draait een goed taalmodel op hardware van enkele duizenden euro\'s, zonder abonnement. De vergelijking met cloudkosten staat in de business case van de startsprint.' },
  { q: 'Waarom zou ik weg willen van Amerikaanse cloud?', a: 'De CLOUD Act geeft de Amerikaanse overheid toegang tot data bij Amerikaanse bedrijven, ongeacht waar de servers staan. Voor overheden, zorg, advocatuur en organisaties met aanbestedingseisen rond datasoevereiniteit is dat een reden om het anders te doen. Voor anderen is het een afweging; we adviseren eerlijk, ook als het antwoord is dat je goed zit waar je zit.' },
  { q: 'Hoe zit het met de AI Act?', a: 'Sinds 2 augustus 2026 is het Nederlandse toezicht operationeel. We classificeren je systemen, bouwen logging en menselijk toezicht in en zorgen dat je team voldoet aan de geletterdheidsplicht van artikel 4. Dat zit in elke bouw; het is de AI Heroes-standaard.' },
  { q: 'Kan ik alleen advies krijgen, zonder bouw?', a: 'De startsprint levert een hostingontwerp en risicobeoordeling op waarmee je zelf verder kunt, ook zonder ons. Een losse sessie over digitale risico\'s en Europese alternatieven voor je team is er ook; die vind je bij training.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'In eigen beheer draaien: soevereine AI en hosting',
  serviceType: 'Sovereign AI implementation and European hosting',
  description: 'AI en software op eigen servers of bij een Europese partij. Lokale modellen, Europese cloud, migratie weg van Amerikaanse cloud, AI-beleid en AI Act-classificatie.',
  provider: { '@id': 'https://aiheroes.io/#organization' },
  areaServed: { '@type': 'Place', name: 'European Union' },
  availableLanguage: ['Dutch', 'English'],
  offers: { '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: '8000' },
  url: 'https://aiheroes.io/nl/diensten/eu-consultancy',
};
---

<SubpageLayout
  lang="nl"
  title="In eigen beheer draaien"
  subtitle="AI en software op je eigen servers of bij een Europese partij. Zonder afhankelijkheid van Amerikaanse cloud, met de AI Act ingebouwd."
  seoTitle="Soevereine AI: op eigen servers of Europees gehost, zonder Amerikaanse cloud"
  seoDescription="AI in eigen beheer draaien met AI Heroes: lokale modellen op eigen hardware, Europese cloud (Mistral, Aleph Alpha, Nederlandse hosting), migratie weg van Amerikaanse cloud, AI-beleid en AI Act-classificatie. Startsprint in één week."
  accentColor="blue"
  badge="In eigen beheer draaien"
  entry="eigen-beheer"
  trustedBy={["UMCG", "Tweede Kamer", "Envalior", "050-IT"]}
  jsonLd={[serviceSchema, faqSchema]}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">“Kan het ook op onze eigen servers? Onze data mag Europa niet uit.”</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      Voor overheden, zorg, advocatuur en organisaties met aanbestedingseisen is dit geen wens maar een voorwaarde. Wij bouwen AI die in Europa blijft: op je eigen hardware of bij een Europese partij, gekoppeld aan je systemen, met de AI Act in het ontwerp.
    </p>
    <p class="text-stone-600 leading-relaxed">We doen het zelf ook. De assistent op deze site is door ons gebouwd en draait op Europese infrastructuur.</p>
    <StatGrid stats={stats} accent="blue" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <Callout variant="red" accent="red" eyebrow="Waarom dit speelt" title="CLOUD Act en AI Act">
      <p>De Amerikaanse CLOUD Act geeft de Amerikaanse overheid toegang tot data die bij Amerikaanse bedrijven is opgeslagen, ongeacht waar de servers staan. Dat geldt voor Microsoft, Google en Amazon, en dus voor ChatGPT, Azure OpenAI en AWS Bedrock.</p>
      <p>Sinds 2 augustus 2026 is het Nederlandse toezicht op de EU AI Act operationeel. Wie AI-systemen gebruikt, moet ze kunnen classificeren, loggen en verantwoorden, en moet kunnen aantonen dat medewerkers voldoende AI-geletterd zijn. In maart 2025 nam de Tweede Kamer moties aan over minder afhankelijkheid van Amerikaanse platformen; aanbestedingen volgen.</p>
    </Callout>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Wat we bouwen</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Vier vormen, vaak in combinatie.</p>
    <CardGrid items={options} cols={2} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Hoe we beginnen</h2>
    <ProcessSteps steps={method} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Zelf doen wat we adviseren</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Het bewijs dat zonder klanttoestemming te tonen is: onze eigen stack.</p>
    <CardGrid items={proof} cols={2} />
  </section>

  <Faq items={faq} title="Veelgestelde vragen" class="mb-16" />

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">De andere ingangen</h2>
    <CardGrid items={related} cols={2} />
  </section>
</SubpageLayout>
