---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProcessSteps from '../../../components/blocks/ProcessSteps.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';

const offerings = [
  { id: 'ai-readiness-scan', title: 'AI Readiness Scan', accent: 'blue' as const, description: 'Waar staat jouw organisatie met AI? We brengen maturiteit, data en cultuur in kaart en geven je een concreet actieplan. 1-3 dagen, vanaf €3.000.' },
  { id: 'procesanalyse', title: 'Procesoptimalisatie', accent: 'blue' as const, description: 'Deep-dive in je bedrijfsprocessen. Waar liggen automatiseringskansen, welke bottlenecks kan AI oplossen? Je krijgt een geprioriteerd kansenregister. 3-5 dagen, vanaf €5.000.' },
  { id: 'opportunity-scouting', title: 'Business Case Analyse', accent: 'red' as const, description: 'Waar laat je geld liggen? Organisatiebrede scan van waar AI het meest oplevert, met een overzicht en de top 3-5 uitgewerkte business cases. Met resultaatgarantie.' },
  { id: 'business-case-development', title: 'Business Case Development', accent: 'red' as const, description: 'Van één AI-kans naar een onderbouwd investeringsvoorstel: ROI, kostenraming en een go/no-go. Board-ready. 1-2 weken, vanaf €5.000.' },
  { id: 'ai-roadmap', title: 'AI Roadmap', accent: 'blue' as const, description: 'Van inzicht naar implementatieplan. Een gefaseerde roadmap: quick wins, korte en lange termijn, inclusief governance en resource planning. Bij ons een fase van een bouw; los kan het ook, 2-4 weken.' },
  { id: 'ai-implementatiebegeleiding', title: 'Implementatiebegeleiding', accent: 'red' as const, description: 'Hands-on begeleiding tijdens de uitrol: change management, adoptietracking en coaching op de werkvloer. De brug tussen plan en werkelijkheid. 2-8 weken.' },
];

const method = [
  { title: 'Intake en discovery', eyebrow: 'Kick-off', body: 'We beginnen waar jij staat. Interviews met stakeholders, een technische audit en een diepgaande analyse van je processen, op locatie of remote.' },
  { title: 'Analyse en prioritering', eyebrow: 'Het werk', body: 'We brengen kansen in kaart, kwantificeren de impact en rangschikken op impact versus inspanning. Omdat we zelf AI bouwen, zijn onze kostenramingen realistisch, geen schattingen uit de lucht.' },
  { title: 'Rapportage en actieplan', eyebrow: 'Oplevering', body: 'Een presentatie van bevindingen en een concreet actieplan aan MT of stuurgroep. Een plan dat werkt, niet een rapport dat stoft. Sluit de business case niet? Dan zeggen we dat.' },
];

const stats = [
  { value: '1 A4', label: 'business case vóór elke bouw' },
  { value: '1 week', label: 'de startsprint, inclusief business case' },
  { value: '70%', label: 'van AI-projecten faalt zonder begeleiding' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Business case in één week', accent: 'red' as const, href: '/nl/cases/kwakkel', description: 'Prototype op eigen data plus de business case op één A4, in zes dagen.' },
  { title: 'Strive', eyebrow: 'Business case vóór de vervanging', accent: 'blue' as const, href: '/nl/cases/strive', description: 'Wat het pakket kostte, wat eigen software kost en wanneer het zich terugverdient, vóór de bouw.' },
];

const related = [
  { title: 'De startsprint', accent: 'red' as const, href: '/nl/startsprint', description: 'Eén week, vast bedrag, een werkend prototype of bouwplan. Altijd met de business case op één A4.' },
  { title: 'Hoe we werken', accent: 'blue' as const, href: '/nl/over-ons/aanpak', description: 'Het traject van business case tot overdracht.' },
];

const faq = [
  { q: 'Wat kost AI-consultancy?', a: 'Een losse readiness scan van 1 tot 3 dagen begint vanaf EUR 3.000; een procesanalyse of business case development vanaf EUR 5.000. In de startsprint (één week, vanaf EUR 8.000) zit de business case voor één concreet systeem inbegrepen. Je weet de kosten vooraf; verrassingen achteraf horen er niet bij.' },
  { q: 'Waar moet mijn organisatie beginnen met AI?', a: 'Heb je al een concreet proces of systeem, dan is de startsprint de eerste stap: één week, werkend prototype of bouwplan, business case erbij. Weet je nog niet waar te beginnen, dan brengt de readiness scan in 1 tot 3 dagen in kaart waar je staat, welke quick wins er liggen en wat de logische volgende stap is.' },
  { q: 'Hoe lang duurt een traject van scan tot roadmap?', a: 'Gemiddeld 2 tot 4 weken. Een losse readiness scan is in een paar dagen klaar; een volledige roadmap met onderbouwde business cases, governance en resourceplanning kost een paar weken. Gaat het om één concreet systeem, dan is de startsprint van één week sneller en concreter.' },
  { q: 'Wat maakt AI Heroes anders dan andere adviesbureaus?', a: 'We bouwen zelf. Daardoor zijn onze kostenramingen realistisch en bouwen we ook wat in de business case staat. Geen overdracht naar een externe bouwer, geen kennislek. En als de business case niet sluit, zeggen we dat eerlijk en bouwen we niet.' },
  { q: 'Begeleiden jullie ook de implementatie?', a: 'Ja. Zo’n 70% van AI-projecten faalt zonder begeleiding, dus we stoppen niet bij het rapport. Met implementatiebegeleiding (2 tot 8 weken) begeleiden we de uitrol op de werkvloer: change management, adoptietracking en coaching, tot AI onderdeel is van het dagelijkse werk.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI Consultancy',
  serviceType: 'AI consultancy',
  description: 'AI-consultancy van readiness scan en business case tot roadmap en implementatiebegeleiding, voor organisaties in heel Nederland.',
  provider: { '@id': 'https://aiheroes.io/#organization' },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  availableLanguage: ['Dutch', 'English'],
  offers: { '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: '3000' },
  url: 'https://aiheroes.io/nl/diensten/consultancy',
};
---

<SubpageLayout
  lang="nl"
  title="AI Consultancy"
  subtitle="Van eerste inzicht naar werkende AI. We beginnen waar jij staat, brengen kansen in kaart en leveren een plan dat rendeert, voordat je investeert."
  seoTitle="AI consultancy: business case, readiness scan en roadmap vóór de bouw"
  seoDescription="AI-consultancy die van readiness-scan naar business case, roadmap en implementatiebegeleiding gaat. Een plan dat werkt, niet een rapport dat stoft. Realistische ramingen, want we bouwen zelf."
  accentColor="blue"
  badge="Business case en scoping"
  trustedBy={["Kwakkel BV", "Strive", "UMCG", "Envalior", "050-IT"]}
  jsonLd={[serviceSchema, faqSchema]}
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Elke bouw begint bij ons met een business case</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      Voordat we bouwen, weet je wat het kost, wat het oplevert en wanneer het zich terugverdient. Op één A4, klaar voor de directie. In de startsprint hoort die business case bij de uitkomst; deze pagina beschrijft hoe we hem maken, en wat je bij ons kunt afnemen als je eerst wilt weten waar te beginnen.
    </p>
    <p class="text-stone-600 leading-relaxed">Omdat wij zelf bouwen, zijn onze ramingen realistisch. Sluit de business case niet, dan bouwen we niet, en zeggen we dat.</p>
    <StatGrid stats={stats} accent="blue" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Het traject, stap voor stap</h2>
    <p class="text-stone-600 leading-relaxed mb-6">De startsprint bevat de readiness scan en de business case voor één concreet systeem. Wil je breder kijken of eerst weten waar te beginnen, dan zijn dit de losse onderdelen.</p>
    <CardGrid items={offerings} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Hoe we werken</h2>
    <ProcessSteps steps={method} />
  </section>

  <section class="mb-16">
    <Callout variant="dark" accent="blue" eyebrow="Onze belofte" title="Een plan dat werkt, niet een rapport dat stoft">
      <p>Omdat we zelf AI bouwen, zijn onze kostenramingen realistisch en niet uit de lucht gegrepen. We adviseren eerlijk over wat voor jouw situatie zinvol is, en als de business case niet sluit, zeggen we dat. Het doel is een actieplan dat je organisatie echt vooruit brengt.</p>
    </Callout>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Business case in de praktijk</h2>
    <CardGrid items={cases} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Veelgestelde vragen</h2>
    <div class="space-y-3">
      {faq.map((f) => (
        <details class="group border border-stone-200 bg-white">
          <summary class="cursor-pointer list-none p-5 font-medium text-brand-dark flex justify-between items-center gap-4">
            <span>{f.q}</span>
            <span class="text-stone-400 group-open:rotate-180 transition-transform flex-shrink-0">&#9662;</span>
          </summary>
          <div class="px-5 pb-5 text-sm text-stone-600 leading-relaxed">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Hoe dit in een bouw past</h2>
    <CardGrid items={related} cols={2} />
  </section>
</SubpageLayout>
