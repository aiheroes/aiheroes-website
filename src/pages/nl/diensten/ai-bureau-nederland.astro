---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import { CONTENT } from '../../../data/content';

const entries = CONTENT.nl.services.items.map((item, i) => ({
  title: item.title,
  eyebrow: item.tag,
  accent: (['red', 'blue', 'dark'] as const)[i],
  href: item.href,
  description: item.description,
}));

const stats = [
  { value: '50+', label: 'organisaties geholpen' },
  { value: '6 dagen', label: 'van vraag naar werkend prototype' },
  { value: '1.000+', label: 'professionals getraind' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Iets nieuws bouwen', accent: 'red' as const, href: '/nl/cases/kwakkel', description: 'Automatisering van de administratie, prototype in zes dagen.' },
  { title: 'INQ22', eyebrow: 'Iets nieuws bouwen', accent: 'red' as const, href: '/nl/cases/inq22', description: 'Een maatwerkwebwinkel, live op inq22.com.' },
  { title: 'Strive', eyebrow: 'Vervangen wat niet meer voldoet', accent: 'blue' as const, href: '/nl/cases/strive', description: 'Een te duur SaaS-pakket vervangen door eigen software.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aiheroes.io/' },
    { '@type': 'ListItem', position: 2, name: 'Wat we bouwen', item: 'https://aiheroes.io/nl/diensten' },
    { '@type': 'ListItem', position: 3, name: 'AI-bureau Nederland', item: 'https://aiheroes.io/nl/diensten/ai-bureau-nederland' },
  ],
};
---

<SubpageLayout
  lang="nl"
  title="AI-bureau voor heel Nederland"
  subtitle="Op zoek naar een AI-bureau dat bouwt? AI Heroes bouwt software en AI voor organisaties door heel Nederland en zet die in productie. Vanuit Groningen."
  seoTitle="AI-bureau Nederland | Software en AI laten bouwen, van prototype tot productie"
  seoDescription="Op zoek naar een AI-bureau in Nederland? AI Heroes bouwt software en AI die in productie draait, met business case, compliance en training inbegrepen. Startsprint in één week, door heel Nederland, vanuit Groningen."
  accentColor="blue"
  trustedBy={["Kwakkel BV", "INQ22", "Strive", "IC Commerce", "UMCG", "Tweede Kamer"]}
  jsonLd={breadcrumbSchema}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Een AI-bureau dat bouwt</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      De meeste AI-bureaus adviseren of trainen. Wij bouwen: software en AI die op de dag van oplevering werkt en blijft werken, gekoppeld aan je ERP, CRM en de rest van je landschap. De business case ervoor, de compliance erin en de training van je team erna zitten in elke bouw. Dat noemen we de AI Heroes-standaard.
    </p>
    <p class="text-stone-600 leading-relaxed">Voor organisaties met een concreet proces, product of systeem, en een eigenaar die kan beslissen. Door heel Nederland, op locatie en op afstand.</p>
    <StatGrid stats={stats} accent="blue" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Drie manieren om binnen te komen</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Kies de ingang die past bij je vraag.</p>
    <CardGrid items={entries} cols={3} />
  </section>

  <section class="mb-16">
    <Callout variant="dark" accent="red" eyebrow="De eerste stap" title="De startsprint">
      <p>Eén week, vast bedrag vanaf €8.000. Aan het eind weet je of het kan, wat het kost en hoe het eruitziet: een werkend prototype of een bouwplan, altijd met de business case op één A4. <a href="/nl/startsprint" class="text-white underline underline-offset-2 hover:no-underline">Lees hoe de week eruitziet &rarr;</a></p>
    </Callout>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Resultaten bij Nederlandse organisaties</h2>
    <CardGrid items={cases} cols={3} />
    <p class="mt-6 text-sm"><a href="/nl/cases" class="text-brand-blue underline underline-offset-2 hover:no-underline">Alle cases &rarr;</a></p>
  </section>

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Door heel Nederland, met basis in Groningen</h2>
    <p class="text-stone-600 leading-relaxed">Onze klanten zitten door het hele land, van de Randstad tot het noorden. We werken op locatie en op afstand. Onze thuisbasis is <a href="/nl/diensten/ai-consultancy-groningen" class="text-brand-blue underline underline-offset-2">Groningen, de AI-hoofdstad van Europa</a>, met de AI Fabriek en een groeiend ecosysteem van AI-talent op de stoep.</p>
  </section>
</SubpageLayout>
