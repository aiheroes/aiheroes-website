---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import Faq from '../../../components/blocks/Faq.astro';
import ProofRow from '../../../components/blocks/ProofRow.astro';
import { CONTENT } from '../../../data/content';

const entries = CONTENT.nl.services.items.map((item, i) => ({
  title: item.title,
  eyebrow: item.tag,
  accent: (['red', 'blue', 'dark'] as const)[i],
  href: item.href,
  description: item.description,
}));

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Iets nieuws bouwen', accent: 'red' as const, href: '/nl/cases/kwakkel', description: 'Automatisering van de administratie. In zes dagen van vraag naar werkend prototype.' },
  { title: 'INQ22', eyebrow: 'Iets nieuws bouwen', accent: 'red' as const, href: '/nl/cases/inq22', description: 'Een maatwerkwebwinkel, live op inq22.com.' },
  { title: 'Strive', eyebrow: 'Vervangen wat niet meer voldoet', accent: 'blue' as const, href: '/nl/cases/strive', description: 'Een te duur SaaS-pakket vervangen door eigen software.' },
];

const faq = [
  { q: 'Bouwen jullie ook software zonder AI?', a: 'Ja. Een webwinkel, een klantportaal, een intern systeem: we bouwen software, met AI waar dat waarde heeft en zonder waar dat niet zo is. INQ22 kreeg een maatwerkwebwinkel die gewoon live draait.' },
  { q: 'Hoe beginnen we?', a: 'Met de startsprint: één week, vast bedrag vanaf €8.000. Aan het eind heb je een werkend prototype of een bouwplan, altijd met de business case op één A4. Daarna beslis je of we doorgaan.' },
  { q: 'Wat als we eerst willen leren wat AI kan?', a: 'Dan is een training een betere eerste stap dan een startsprint. Bij elke bouw trainen we het team dat ermee gaat werken; los kan het ook. Je vindt het onder Hoe we werken.' },
  { q: 'Werken jullie door heel Nederland?', a: 'Ja. Onze thuisbasis is Groningen, we werken op locatie en op afstand door heel Nederland en daarbuiten.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<SubpageLayout
  lang="nl"
  title="Wat we bouwen"
  subtitle="Software en AI die in productie draait. Drie manieren om te beginnen, één voordeur."
  seoTitle="Wat we bouwen: software en AI, van prototype tot productie"
  seoDescription="AI Heroes bouwt software en AI voor organisaties die verder willen dan een pilot. Iets nieuws bouwen, software vervangen of AI in eigen beheer draaien. Business case, compliance en training inbegrepen."
  accentColor="red"
  trustedBy={["Kwakkel BV", "INQ22", "Strive", "IC Commerce", "UMCG", "Tweede Kamer"]}
  jsonLd={faqSchema}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Drie manieren om binnen te komen</h2>
    <p class="text-lg text-stone-600 leading-relaxed">
      Je hebt een idee, een proces dat beter kan of software die aan vervanging toe is. Wij bouwen wat je nodig hebt en zorgen dat het draait: met een sluitende business case, compliance vanaf de tekentafel en een team dat ermee overweg kan. Kies de ingang die past bij je vraag.
    </p>
  </section>

  <section class="mb-16">
    <CardGrid items={entries} cols={3} />
  </section>

  <section class="mb-16">
    <Callout variant="dark" accent="red" eyebrow="De voordeur" title="De startsprint">
      <p>Eén week, vast bedrag vanaf €8.000. Aan het eind weet je of het kan, wat het kost en hoe het eruitziet: een werkend prototype of een bouwplan, altijd met de business case op één A4. <a href="/nl/startsprint" class="text-white underline underline-offset-2 hover:no-underline">Lees hoe de week eruitziet &rarr;</a></p>
    </Callout>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Waar we het bewezen</h2>
    <CardGrid items={cases} cols={3} />
    <p class="mt-6 text-sm"><a href="/nl/cases" class="text-brand-red underline underline-offset-2 hover:no-underline">Alle cases &rarr;</a></p>
  </section>

  <Faq items={faq} title="Veelgestelde vragen" class="mb-16" />

  <section>
    <ProofRow label="Vertrouwd door" items={["Kwakkel BV", "INQ22", "Strive", "IC Commerce", "UMCG", "Tweede Kamer", "Postcode Loterij", "Envalior"]} />
  </section>
</SubpageLayout>
