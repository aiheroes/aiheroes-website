---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import Faq from '../../../components/blocks/Faq.astro';
import { PROFESSIONAL_SERVICE_SCHEMA } from '../../../data/schema';
import { CONTENT } from '../../../data/content';

const entries = CONTENT.nl.services.items.map((item, i) => ({
  title: item.title,
  eyebrow: item.tag,
  accent: (['red', 'blue', 'dark'] as const)[i],
  href: item.href,
  description: item.description,
}));

const stats = [
  { value: '50+', label: 'organisaties geholpen' },
  { value: '6 dagen', label: 'van vraag naar werkend prototype' },
  { value: 'Aarhusweg', label: 'koffie staat klaar' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Iets nieuws bouwen', accent: 'red' as const, href: '/nl/cases/kwakkel', description: 'Automatisering van de administratie, prototype in zes dagen.' },
  { title: 'Strive', eyebrow: 'Vervangen wat niet meer voldoet', accent: 'blue' as const, href: '/nl/cases/strive', description: 'Een te duur SaaS-pakket vervangen door eigen software.' },
  { title: 'Onze eigen stack', eyebrow: 'In eigen beheer draaien', accent: 'dark' as const, href: '/nl/cases/eigen-stack', description: 'De assistent op deze site: Europees gehost, met de AI Act ingebouwd.' },
];

const FAQ = [
  { q: 'Wat doet een AI-bureau in Groningen voor mijn organisatie?', a: 'AI Heroes bouwt software en AI en zet die in productie. Je komt binnen met een concrete vraag: iets nieuws bouwen, software vervangen of AI in eigen beheer draaien. De eerste stap is altijd een startsprint van één week, met een werkend prototype of bouwplan en de business case op één A4.' },
  { q: 'Wat kost het?', a: 'De startsprint kost vanaf EUR 8.000, vast bedrag, vooraf bekend. Een maatwerkbouw daarna begint vanaf EUR 15.000. Losse trainingen zijn er vanaf EUR 2.500 per dag. Wat jouw bouw precies kost, staat aan het eind van de startsprint op papier.' },
  { q: 'Werken jullie alleen met bedrijven in Groningen?', a: 'Onze thuisbasis is Groningen en daar zit een groot deel van onze klanten, maar we werken door heel Nederland en Europa. Voor organisaties in Groningen en Noord-Nederland zitten we letterlijk om de hoek: langskomen is bij ons standaard.' },
  { q: 'Helpen jullie ook met de EU AI Act?', a: 'Ja. Compliance zit in elke bouw: we classificeren het systeem onder de AI Act, bouwen logging en menselijk toezicht in en trainen het team dat ermee werkt, zodat je voldoet aan artikel 4. Sinds 2 augustus 2026 is het Nederlandse toezicht operationeel.' },
  { q: 'Hoe snel kunnen we starten?', a: 'Een startsprint plannen we meestal binnen twee weken. Aan het eind van die week staat er een werkend prototype of een bouwplan. Bij Kwakkel BV stond het prototype voor de administratie-automatisering na zes dagen.' },
];

const PAGE_URL = 'https://aiheroes.io/nl/diensten/ai-consultancy-groningen';

// Page-level org block replaces the sitewide one (BaseLayout detects ProfessionalService):
// same entity (@id), but scoped to this page URL with explicit local service area.
const localBusinessSchema = {
  ...PROFESSIONAL_SERVICE_SCHEMA,
  url: PAGE_URL,
  areaServed: [
    { '@type': 'City', name: 'Groningen' },
    { '@type': 'Place', name: 'Noord-Nederland' },
    { '@type': 'Place', name: 'European Union' },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aiheroes.io/' },
    { '@type': 'ListItem', position: 2, name: 'Wat we bouwen', item: 'https://aiheroes.io/nl/diensten' },
    { '@type': 'ListItem', position: 3, name: 'AI-bureau Groningen', item: PAGE_URL },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<SubpageLayout
  lang="nl"
  title="AI-bureau in Groningen"
  subtitle="Software en AI laten bouwen in de AI-hoofdstad van Europa. Voor organisaties in Groningen, Noord-Nederland en daarbuiten."
  seoTitle="AI consultancy Groningen | Software en AI laten bouwen"
  seoDescription="Op zoek naar AI consultancy in Groningen? AI Heroes aan de Aarhusweg bouwt software en AI die in productie draait, met business case, compliance en training inbegrepen. Startsprint in één week."
  accentColor="red"
  trustedBy={["Kwakkel BV", "UMCG", "Hanze", "050-IT", "Tweede Kamer"]}
  jsonLd={[localBusinessSchema, breadcrumbSchema, faqSchema]}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Een AI-bureau om de hoek, dat bouwt</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      AI Heroes bouwt software en AI voor organisaties die verder willen dan een pilot, en zet die in productie. Wie in Groningen of Noord-Nederland zit, heeft ons om de hoek: we komen langs, kennen de regio en blijven betrokken na de oplevering. Sinds 2019 als merk, sinds eind 2025 met het huidige team, hielpen we meer dan 50 organisaties, van het mkb in het noorden tot de Tweede Kamer.
    </p>
    <StatGrid stats={stats} accent="red" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Drie manieren om binnen te komen</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Kies de ingang die past bij je vraag. De eerste stap is altijd een <a href="/nl/startsprint" class="text-brand-red underline underline-offset-2 hover:no-underline">startsprint</a>.</p>
    <CardGrid items={entries} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Groningen is de AI-hoofdstad van Europa</h2>
    <p class="text-stone-600 leading-relaxed mb-4">
      Wie AI serieus neemt, zit in Groningen goed. Met de AI Fabriek komt er EUR 200 miljoen aan AI-rekenkracht en -infrastructuur naar de stad. Daaromheen groeit een ecosysteem van kennisinstellingen, startups en gevestigde bedrijven die AI toepassen in de praktijk.
    </p>
    <p class="text-stone-600 leading-relaxed">
      AI Heroes zit middenin dat ecosysteem. We organiseren de <a href="/nl/ai-salon" class="text-brand-red underline underline-offset-2">AI Salon Groningen</a>, werken samen met de Hanzehogeschool en het UMCG, en bouwen voor Noordelijke organisaties als Kwakkel BV en 050-IT.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Resultaten, geen beloftes</h2>
    <CardGrid items={cases} cols={3} />
  </section>

  <section class="mb-16">
    <Callout variant="light" accent="red" eyebrow="Bezoekadres" title="Aarhusweg 4-16, 9723 JJ Groningen">
      <p>AI Heroes B.V. Koffie staat klaar. Vertel onderaan deze pagina wat je wilt bouwen, of mail <a href="mailto:hello@aiheroes.io" class="text-brand-red underline underline-offset-2">hello@aiheroes.io</a>.</p>
    </Callout>
  </section>

  <Faq items={FAQ} title="Veelgestelde vragen" />
</SubpageLayout>
