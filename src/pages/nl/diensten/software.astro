---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProcessSteps from '../../../components/blocks/ProcessSteps.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import Faq from '../../../components/blocks/Faq.astro';

const builds = [
  { id: 'assistenten', title: 'Assistenten en spraak-AI', accent: 'red' as const, description: 'Een assistent die vragen van klanten of medewerkers beantwoordt op jouw documenten, of een telefoonlijn die de eerste vraag zelf afhandelt. Met doorschakeling naar een mens en logging van elk gesprek.' },
  { id: 'werkstromen', title: 'Werkstromen en administratie', accent: 'red' as const, description: 'Offertes, werkbonnen, aanvragen, facturen: het werk dat nu handmatig door drie systemen gaat, automatisch verwerkt.' },
  { id: 'interne-tools', title: 'Interne tools en klantportalen', accent: 'blue' as const, description: 'Een planningsysteem, een dashboard, een portaal waar klanten hun eigen zaken regelen. Software die past bij hoe jullie werken.' },
  { id: 'webapplicaties', title: 'Webapplicaties en webwinkels', accent: 'blue' as const, description: 'Ook zonder AI. INQ22 kreeg een maatwerkwebwinkel die gewoon live draait. AI is bij ons gereedschap, geen doel.' },
  { id: 'zoeken-en-documenten', title: 'Zoeken en documentverwerking', accent: 'dark' as const, description: 'Zoeken door al je documenten met een gewone vraag, contracten en rapporten automatisch uitlezen, samenvattingen die kloppen. Op jouw data, binnen jouw muren als dat moet.' },
  { id: 'dedicated-teams', title: 'Extra bouwcapaciteit', accent: 'dark' as const, description: 'Heb je zelf developers, dan versterken we jouw team met AI-expertise: een tech lead en één tot vijf developers, binnen een week productief.' },
];

const method = [
  { title: 'Startsprint', eyebrow: 'Week 1', body: 'Eén week, vast bedrag. Intake, prototype op jouw data, demo en de business case op één A4. Daarna beslis je of we doorgaan.', href: '/nl/startsprint', hrefLabel: 'Meer over de startsprint' },
  { title: 'Bouwen in sprints', eyebrow: 'Week 2 tot 12', body: 'Korte sprints met een demo aan het eind van elke sprint, zodat je altijd ziet waar we staan. Compliance zit vanaf de tekentafel in het ontwerp: AI Act-classificatie, logging, menselijk toezicht en hosting.' },
  { title: 'In productie en overgedragen', eyebrow: 'Oplevering', body: 'Het systeem draait, gekoppeld aan je landschap. Het team dat ermee werkt is erop getraind. Broncode, documentatie en datamodel zijn van jou.' },
];

const stats = [
  { value: '6 dagen', label: 'van vraag naar werkend prototype' },
  { value: 'Vanaf €15.000', label: 'voor een maatwerkbouw' },
  { value: 'Geen lock-in', label: 'broncode en datamodel blijven van jou' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Iets nieuws bouwen', accent: 'red' as const, href: '/nl/cases/kwakkel', description: 'Automatisering van de administratie. In zes dagen van vraag naar werkend prototype.' },
  { title: 'INQ22', eyebrow: 'Iets nieuws bouwen', accent: 'blue' as const, href: '/nl/cases/inq22', description: 'Een maatwerkwebwinkel, live op inq22.com. Software zonder AI, gebouwd met AI.' },
];

const earlier = [
  { title: 'Medux', eyebrow: 'Eerdere case', accent: 'dark' as const, href: '/nl/cases/medux', description: 'Voice-to-voice AI-klantenservice in de zorg.' },
  { title: 'Trabu', eyebrow: 'Eerdere case', accent: 'dark' as const, href: '/nl/cases/trabu', description: 'Van idee naar prototype voor een investeerdersronde.' },
  { title: 'InnoEnergy', eyebrow: 'Eerdere case', accent: 'dark' as const, href: '/nl/cases/innoenergy', description: 'Prototype van een investment intelligence platform.' },
];

const related = [
  { title: 'Vervangen wat niet meer voldoet', accent: 'blue' as const, href: '/nl/diensten/software-vervangen', description: 'Verouderde of te dure software eruit, iets dat past ervoor in de plaats.' },
  { title: 'In eigen beheer draaien', accent: 'dark' as const, href: '/nl/diensten/eu-consultancy', description: 'Op je eigen servers of bij een Europese partij, met de AI Act ingebouwd.' },
];

const faq = [
  { q: 'Wat kost het om software of AI te laten bouwen?', a: 'De startsprint kost vanaf €8.000 en duurt één week. Een maatwerkbouw daarna begint vanaf €15.000 en loopt tot ruim €100.000 voor grote systemen. Aan het eind van de startsprint weet je wat jouw bouw kost, wat hij oplevert en wanneer hij zich terugverdient.' },
  { q: 'Hoe snel staat er iets?', a: 'In de startsprint staat binnen een week een werkend prototype op jouw data. Bij Kwakkel BV stond het prototype voor de administratie-automatisering na zes dagen. Een productiesysteem volgt daarna in sprints van twee weken.' },
  { q: 'Bouwen jullie ook software zonder AI?', a: 'Ja. INQ22 kreeg een maatwerkwebwinkel die live draait. We bouwen software; AI zetten we in waar het waarde heeft en laten we weg waar het dat niet heeft.' },
  { q: 'Werken jullie samen met ons eigen developmentteam?', a: 'Ja, op drie manieren: wij bouwen zelfstandig, wij versterken jouw team met een tech lead en developers, of hybride. Elke oplevering bevat documentatie en training, zodat jouw mensen zelfstandig verder kunnen.' },
  { q: 'Hoe voorkomen jullie vendor lock-in?', a: 'Open standaarden waar mogelijk, Europese hosting waar het ertoe doet, en broncode, documentatie en datamodel die van jou zijn. Je zit nooit vast aan één leverancier, ook niet aan ons.' },
  { q: 'Hoe zit het met de AI Act?', a: 'Compliance zit in het ontwerp: we classificeren het systeem onder de AI Act, bouwen logging en menselijk toezicht in en kiezen hosting die past bij je data. Het team dat ermee werkt, trainen we op het systeem; daarmee voldoe je meteen aan artikel 4.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Iets nieuws bouwen: maatwerksoftware en AI',
  serviceType: 'Custom software and AI development',
  description: 'Assistenten, werkstromen, interne tools, klantportalen, webapplicaties en documentverwerking. Van prototype in zes dagen tot systeem in productie, met business case, compliance en training inbegrepen.',
  provider: { '@id': 'https://aiheroes.io/#organization' },
  areaServed: { '@type': 'Place', name: 'European Union' },
  availableLanguage: ['Dutch', 'English'],
  offers: { '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: '8000' },
  url: 'https://aiheroes.io/nl/diensten/software',
};
---

<SubpageLayout
  lang="nl"
  title="Iets nieuws bouwen"
  subtitle="Een assistent, een werkstroom of een tool die je nu mist. Van prototype in zes dagen tot systeem in productie, gebouwd met jouw team en gekoppeld aan jouw landschap."
  seoTitle="Software en AI laten bouwen: van prototype in 6 dagen tot productie"
  seoDescription="Iets nieuws laten bouwen door AI Heroes: assistenten, werkstromen, interne tools, webapplicaties en documentverwerking. Startsprint in één week, maatwerk vanaf €15.000. Business case, compliance en training inbegrepen."
  accentColor="red"
  badge="Iets nieuws bouwen"
  entry="nieuw"
  trustedBy={["Kwakkel BV", "INQ22", "IC Commerce", "UMCG"]}
  jsonLd={[serviceSchema, faqSchema]}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">“Kunnen jullie dit voor ons bouwen?”</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      Er is een proces dat te veel handwerk kost, een idee voor een assistent, een tool die het team al jaren mist. Wij bouwen het: eerst in één week een prototype op jouw data, daarna in sprints door tot het in productie draait.
    </p>
    <p class="text-stone-600 leading-relaxed">Met AI waar dat waarde heeft, en zonder waar dat niet zo is. Voor organisaties die weten wat ze willen bouwen en een eigenaar hebben die kan beslissen.</p>
    <StatGrid stats={stats} accent="red" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Wat we bouwen</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Zes soorten werk die we vaak doen. Staat het jouwe er niet bij, dan is de startsprint de manier om erachter te komen of het kan.</p>
    <CardGrid items={builds} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Hoe we beginnen</h2>
    <ProcessSteps steps={method} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Waar we het bewezen</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Werk van het huidige team.</p>
    <CardGrid items={cases} cols={2} />
    <h3 class="font-serif text-xl text-brand-dark mt-10 mb-4">Eerdere cases</h3>
    <p class="text-sm text-stone-500 mb-4">Werk uit de tijd vóór de overname eind 2025, dat de merknaam AI Heroes meebracht.</p>
    <CardGrid items={earlier} cols={3} />
  </section>

  <section class="mb-16">
    <Callout variant="light" accent="blue" eyebrow="Overdracht" title="Zonder lock-in">
      <p>We werken met open standaarden waar mogelijk en Europese hosting waar het ertoe doet. Broncode, documentatie en datamodel zijn van jou. Je kunt zonder ons verder als je dat wilt.</p>
    </Callout>
  </section>

  <Faq items={faq} title="Veelgestelde vragen" class="mb-16" />

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">De andere ingangen</h2>
    <CardGrid items={related} cols={2} />
  </section>
</SubpageLayout>
