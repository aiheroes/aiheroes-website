---
// P7 De startsprint (docs/relaunch/pages/P7-startsprint.md): the front door. Six days, from €8.000
// for all three entries, start within two weeks (docs/relaunch/01-besluiten.md §1).
import HsLayout from '../../layouts/HsLayout.astro';
import HsPageCover from '../../components/hs/HsPageCover.astro';
import HsSection from '../../components/hs/HsSection.astro';
import HsCards from '../../components/hs/HsCards.astro';
import HsSteps from '../../components/hs/HsSteps.astro';
import HsCase from '../../components/hs/HsCase.astro';
import HsFit from '../../components/hs/HsFit.astro';
import HsFaq from '../../components/hs/HsFaq.astro';
import HsContact from '../../components/hs/HsContact.astro';
import { SITE, ENTRIES } from '../../data/site';
import { serviceSchema, faqSchema } from '../../data/schema';

const s = SITE.sprint;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Hoe we werken', href: '/nl/hoe-we-werken' }];

const outcomes = [
  { title: ENTRIES.nieuw.title, accent: 'red' as const, href: ENTRIES.nieuw.href, more: 'Meer over nieuwe AI-toepassingen', text: 'Een werkend prototype op je eigen data. Je team probeert het uit voordat er een bouwbesluit ligt.' },
  { title: ENTRIES.vervangen.title, accent: 'blue' as const, href: ENTRIES.vervangen.href, more: 'Meer over software vervangen', text: 'Een architectuur en een migratieplan: wat er komt, wat er blijft en in welke volgorde je overstapt.' },
  { title: ENTRIES['eigen-beheer'].title, accent: 'dark' as const, href: ENTRIES['eigen-beheer'].href, more: 'Meer over software in eigen beheer', text: 'Een hostingontwerp en een risicobeoordeling: waar het draait, wie erbij kan en wat de AI Act vraagt.' },
];

const days = [
  { label: 'Dag 1', title: 'Intake en scope', text: 'We gaan om tafel met de eigenaar en de mensen die het werk doen. Samen bepalen we wat er op dag zes moet staan.', meta: 'Van jou: de eigenaar en twee of drie gebruikers, een halve dag.' },
  { label: 'Dag 2 en 3', title: 'Bouwen of ontwerpen', text: 'We bouwen het prototype, of we ontwerpen de nieuwe architectuur of de hosting.', meta: 'Van jou: iemand voor vragen, een uur per dag.' },
  { label: 'Dag 4', title: 'Koppelen aan je echte data', text: 'Het prototype gaat draaien op je eigen data en systemen, naast het huidige werk.', meta: 'Van jou: iemand die je data en systemen kent, een paar uur.' },
  { label: 'Dag 5', title: 'Testen met gebruikers', text: 'Je mensen werken ermee. Wat schuurt, passen we dezelfde dag aan.', meta: 'Van jou: de gebruikers, een uur.' },
  { label: 'Dag 6', title: 'Demo, business case en besluit', text: 'We laten zien wat er staat, met de business case op één A4. Jij besluit: bouwen, bijsturen of stoppen.', meta: 'Van jou: de eigenaar, een uur.' },
];

const faq = [
  { q: 'Wat kost een startsprint?', a: `Een vaste prijs, vanaf ${s.price}, voor alle drie de ingangen. De prijs ligt vast voordat we beginnen.` },
  { q: 'Hoe snel kunnen we beginnen?', a: `Binnen ${s.startWithin} na het eerste gesprek. Na je aanvraag hoor je binnen ${SITE.reply} van ons, meestal met een voorstel.` },
  { q: 'Wat moeten wij zelf vrijmaken?', a: 'De eigenaar op dag 1 en dag 6, een paar gebruikers voor de intake en de test, en een paar uur van iemand die je data en systemen kent. Het bouwen doen wij.' },
  { q: 'Wat als het niet lukt in zes dagen?', a: 'Dan weet je dat na zes dagen, met de reden erbij. Soms is een vraag groter dan gedacht; dan staat in het plan wat er nodig is. Is AI niet de oplossing, dan zeggen we dat.' },
  { q: 'Is de prijs anders per ingang?', a: `Nee. Vanaf ${s.price} voor alle drie: iets nieuws laten bouwen, oude software vervangen of software in eigen beheer draaien.` },
  { q: 'Kan het ook zonder startsprint?', a: 'Bijna nooit. De startsprint voorkomt dat we iets bouwen waarvan de business case niet sluit. Alleen als je [extra developers in je team](/nl/extra-developers) zoekt, beginnen we met een kennismaking.' },
  { q: 'Werkt het ook voor software zonder AI?', a: 'Ja. We bouwen wat je nodig hebt, met of zonder AI. De webwinkel van [INQ22](/nl/cases/inq22) bevat zelf geen AI en is wel met AI gebouwd.' },
  { q: 'Wat gebeurt er na de startsprint?', a: `Gaat de bouw door, dan is de startsprint fase 1. We bouwen in sprints van ${SITE.build.sprintWeeks} weken, vanaf ${SITE.build.from}, en na oplevering blijven wij beheren en doorontwikkelen. Gaat hij niet door, dan houd je prototype of plan en de business case.` },
];
---

<HsLayout
  title="De startsprint"
  seoTitle="De startsprint: in zes dagen een werkend prototype of bouwplan"
  description={`De startsprint van AI Heroes: zes dagen, vaste prijs, vanaf ${s.price}, start binnen twee weken. Een werkend prototype of bouwplan met de business case op één A4.`}
  crumbs={crumbs}
  jsonLd={[
    serviceSchema({ name: 'Startsprint', path: '/nl/startsprint', price: s.priceValue, serviceType: 'AI-prototype en business case', description: `Zes dagen, vaste prijs, vanaf ${s.price}: een werkend prototype of bouwplan met de business case op één A4.` }),
    faqSchema(faq),
  ]}
>
  <HsPageCover
    accent="red"
    crumbs={crumbs}
    current="De startsprint"
    title="Zes dagen. Vaste prijs. | Dan *weet* je het."
    lede={`De startsprint is de eerste stap van elke bouw. Aan het eind van dag zes weet je of het kan, wat het kost en hoe het eruitziet.`}
    cta={{ label: 'Plan een startsprint', href: '#contact' }}
    secondary={{ label: 'Bekijk de zes dagen', href: '#zes-dagen' }}
    facts={[
      { value: '6 dagen', label: 'van vraag naar prototype of bouwplan' },
      { value: s.price, label: 'vaste prijs, voor alle ingangen' },
      { value: '2 weken', label: 'na het eerste gesprek kun je beginnen' },
    ]}
  />

  <HsSection title="Wat je na zes dagen *in handen* hebt" lede="Wat er op dag zes ligt, hangt af van je vraag. Altijd met de business case op één A4: wat de bouw kost, wat hij oplevert en wanneer hij zich terugverdient." split>
    <HsCards variant="planes" items={outcomes} />
  </HsSection>

  <HsSection id="zes-dagen" tone="paper" title="Zes dagen, *dag voor dag*" lede="Het werk ligt bij ons. Van jouw kant zijn er per dag een paar mensen nodig, een paar uur.">
    <HsSteps items={days} />
  </HsSection>

  <HsCase
    id="voorbeeld"
    snap={false}
    kicker="Voorbeeld"
    title="Van vraag naar | werkend prototype | in zes dagen"
    lede="Kwakkel BV wilde zelf zien of het administratieve handwerk eruit kon, in plaats van erover te lezen in een rapport. Na zes dagen draaide een prototype op hun eigen administratie, met de business case op één A4."
    stats={[{ value: 6, label: 'dagen van vraag tot werkend prototype' }]}
    close="Wat het systeem niet zeker weet, legt het voor aan een medewerker. Kwakkel houdt het prototype, het plan en de business case, en besluit zelf wanneer de bouw begint."
    link={{ label: 'Lees de case', href: '/nl/cases/kwakkel' }}
    photo={{ src: '/hs/photos/cover-office.webp', w: 1800, h: 1200, pos: '55% 50%' }}
  />

  <HsSection title="En *daarna*">
    <HsCards
      columns={2}
      items={[
        { icon: 'check', title: 'Gaat de bouw door', text: `Dan is de startsprint fase 1. We bouwen in sprints van ${SITE.build.sprintWeeks} weken, vanaf ${SITE.build.from}, met een demo na elke sprint. Na oplevering blijven wij beheren en doorontwikkelen.`, href: '/nl/hoe-we-werken', more: 'Zo werken we' },
        { icon: 'close', title: 'Sluit de business case niet', text: 'Dan bouwen we niet. Je houdt het prototype of het plan en de business case. Een eerlijk besluit na zes dagen bespaart je een project dat niemand gebruikt.', href: '/nl/business-case', more: 'Kosten en opbrengst vooraf' },
      ]}
    />
  </HsSection>

  <HsSection tone="paper" title="Is dit iets *voor jou*?">
    <HsFit
      yes={{ title: 'Ja, als je', items: ['een proces, systeem of idee hebt dat geld kost of groei remt', 'iemand hebt die over de bouw kan beslissen', 'zes dagen een paar uur van je eigen mensen kunt vrijmaken'] }}
      no={{ title: 'Nog niet, als je', items: ['eerst wilt weten waar AI in je organisatie iets oplevert: begin dan met [kosten en opbrengst vooraf](/nl/business-case)', 'vooral je team wilt leren werken met AI: kijk dan bij [AI-training voor je team](/nl/training)'] }}
    />
  </HsSection>

  <HsSection title="Veelgestelde *vragen*">
    <HsFaq items={faq} />
  </HsSection>

  <HsContact title="Plan je startsprint" lede={`Vertel wat je wilt bouwen. Binnen ${SITE.reply} hoor je van ons, meestal met een voorstel voor je startsprint.`} />
</HsLayout>
