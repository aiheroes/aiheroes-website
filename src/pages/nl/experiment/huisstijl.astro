---
// Experiment (2026-10): the homepage in the AI Heroes house style from aiheroes-present
// (presentatietemplate 2.0) and aiheroes-hub (posttaal). Noindex, NL only, live homepage untouched.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/huisstijl.css';
import { CONTENT } from '../../../data/content';
import HsDuotone from '../../../components/experiment/HsDuotone.astro';
import HsNav from '../../../components/experiment/HsNav.astro';
import HsCover from '../../../components/experiment/HsCover.astro';
import HsEntries from '../../../components/experiment/HsEntries.astro';
import HsQuotes from '../../../components/experiment/HsQuotes.astro';
import HsStandard from '../../../components/experiment/HsStandard.astro';
import HsCase from '../../../components/experiment/HsCase.astro';
import HsPlace from '../../../components/experiment/HsPlace.astro';
import HsStatement from '../../../components/experiment/HsStatement.astro';
import HsContact from '../../../components/experiment/HsContact.astro';
import HsFooter from '../../../components/experiment/HsFooter.astro';

const c = CONTENT.nl;
const home = '/nl/experiment/huisstijl';
---

<BaseLayout
  lang="nl"
  title="Homepage in de huisstijl"
  description="Experiment: de homepage van AI Heroes in de huisstijl van de presentaties en LinkedIn-posts."
  noindex
  noChrome
>
  <script is:inline>document.documentElement.classList.add('hs-js');</script>
  <div class="hs">
    <HsDuotone />
    <HsNav nav={c.nav} home={home} />
    <main>
      <HsCover hero={c.hero} approach={c.approach} ctaHref={c.nav.cta.href} />
      <HsEntries services={c.services} />
      <HsQuotes proof={c.socialProof} />
      <HsStandard standard={c.standard} />
      <HsCase />
      <HsPlace team={c.team} />
      <HsStatement approach={c.approach} />
      <HsContact contact={c.contact} contactForm={c.contactForm} />
    </main>
    <HsFooter footer={c.footer} nav={c.nav} />
  </div>
</BaseLayout>

<script>
  import '../../../components/experiment/hs-client';
</script>
