---
// P11 Over ons (docs/relaunch/pages/P11-over-ons.md): who is behind AI Heroes. The takeover at the
// end of 2025 is told explicitly and the market story lives here (01-besluiten §2, §9); 50+ and
// 1.000+ always "sinds 2019"; no industry advisor (§13).
import HsLayout from '../../../layouts/HsLayout.astro';
import HsPageCover from '../../../components/hs/HsPageCover.astro';
import HsSection from '../../../components/hs/HsSection.astro';
import HsCards from '../../../components/hs/HsCards.astro';
import HsPlace from '../../../components/hs/HsPlace.astro';
import HsContact from '../../../components/hs/HsContact.astro';
import HsIcon from '../../../components/hs/HsIcon.astro';
import { CONTENT } from '../../../data/content';
import { SITE } from '../../../data/site';
import { FOUNDERS, FOUNDER_ORDER } from '../../../data/team';
import { zet } from '../../../components/hs/hs';

const crumbs = [{ label: 'Home', href: '/' }];
const founders = FOUNDER_ORDER.map((id) => FOUNDERS[id]);
const LOGOS = [
  { name: 'UMCG', src: '/hs/logos-white/umcg.svg', h: 22 },
  { name: 'Tweede Kamer', src: '/hs/logos-white/tweede-kamer.svg', h: 36 },
  { name: 'Nationale Postcode Loterij', src: '/hs/logos-white/postcode-loterij.svg', h: 32 },
  { name: 'Envalior', src: '/hs/logos-white/envalior.svg', h: 34 },
  { name: 'Banijay Benelux', src: '/hs/logos-white/banijay.svg', h: 26 },
  { name: 'Prosus', src: '/hs/logos-white/prosus.svg', h: 42 },
  { name: 'Hanzehogeschool', src: '/hs/logos-white/hanze.svg', h: 30 },
];
const team = { ...CONTENT.nl.team, cta: { text: 'AI-bureau in Groningen', href: '/nl/ai-bureau-groningen' } };
---

<HsLayout
  title="Over AI Heroes"
  seoTitle="Over AI Heroes: AI-toepassingen bouwen vanuit Groningen"
  description="AI Heroes bouwt AI-toepassingen die je team elke dag gebruikt. Merk sinds 2019, eind 2025 overgenomen door Frans Hoorn, David Homan en Jan Brusse. Vanuit Groningen, aan de Aarhusweg."
  crumbs={crumbs}
>
  <HsPageCover
    accent="red"
    crumbs={crumbs}
    current="Over ons"
    title="Over AI Heroes"
    lede="AI Heroes bouwt AI-toepassingen die je team elke dag gebruikt, voor organisaties die verder willen dan een pilot. Met een sluitende business case, compliance vanaf de tekentafel en een team dat ermee overweg kan. Van ambitie tot implementatie."
    facts={[
      { value: SITE.proof.orgs, label: 'organisaties geholpen sinds 2019' },
      { value: SITE.proof.trained, label: 'professionals getraind sinds 2019' },
      { value: '6 dagen', label: 'van vraag naar werkend prototype' },
    ]}
  />

  <HsSection title="Een merk uit 2019, | opnieuw *begonnen*" lede="De naam AI Heroes bestaat sinds 2019. Eind 2025 namen Frans Hoorn, David Homan en Jan Brusse het merk en de klantrelaties over van de vorige eigenaar en begonnen ze opnieuw.">
    <div class="hs-prose about-story" data-item>
      <p>{zet('Frans werkte drie jaar in het management van het oorspronkelijke AI Heroes, David twee jaar in de operatie. Op 1 mei 2026 is AI Heroes B.V. in Groningen opgericht. Sindsdien bouwen we vanaf de Aarhusweg voor organisaties in heel Nederland en Europa.')}</p>
    </div>
  </HsSection>

  <HsSection tone="dark" title="Waarom AI Heroes *bestaat*" lede="De AI-markt is versnipperd. Adviesbureaus schrijven rapporten, trainingsbureaus trainen en vertrekken, techbedrijven bouwen tools die weinig mensen gebruiken.">
    <p class="hs-lead" data-item>{zet('Wij bouwen wat je team elke dag gebruikt, en blijven het beheren.', { display: true })}</p>
  </HsSection>

  <HsSection title="Waar we in *geloven*">
    <HsCards
      columns={4}
      items={[
        { icon: 'comments', title: 'Eerlijkheid boven verkoop', text: 'Als AI niet de oplossing is, zeggen we dat. Sluit de business case niet, dan bouwen we niet.' },
        { icon: 'tool', title: 'Maatwerk boven standaard', text: 'We bouwen wat bij jouw werk past, ook als dat software zonder AI is.' },
        { icon: 'code', title: 'We bouwen zelf', text: 'We adviseren en bouwen. Onze eigen AI-assistent draait op deze site, gehost in Europa.', href: '/nl/cases/eigen-stack', more: 'Lees de case' },
        { icon: 'local', title: 'Groningen', text: 'Geworteld in Groningen, waar de AI Fabriek komt. Een lokale basis en een Europees werkgebied.' },
      ]}
    />
  </HsSection>

  <HsSection tone="paper" title="De drie *oprichters*" lede="Elk van hen draagt een deel van hetzelfde traject: de business case, de bouw en de training van je mensen.">
    <ul class="about-founders">
      {founders.map((f, i) => (
        <li data-item style={`--i:${i}`}>
          <a href="/nl/over-ons/team">
            <span class="about-founders__photo"><img src={f.photo} alt="" width="300" height="400" loading="lazy" decoding="async" /></span>
            <span class="about-founders__name">{f.name}</span>
            <span class="about-founders__role">{f.role}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="hs-sec__foot" data-item><a class="hs-link" href="/nl/over-ons/team">Het team<HsIcon name="arrow-right" /></a></p>
  </HsSection>

  <HsPlace team={team} />

  <HsSection title="Organisaties waar we mee *werkten*">
    <ul class="hs-logos hs-logos--light hs-logos--bare" data-item>
      {LOGOS.map((l) => <li><img src={l.src} alt={l.name} style={`--h:${l.h / 16}rem`} loading="lazy" decoding="async" /></li>)}
    </ul>
  </HsSection>

  <HsSection tone="paper" title="Verder *kijken*">
    <HsCards
      columns={4}
      items={[
        { title: 'Het team', text: 'Frans, David en Jan, en met wie je over welke vraag praat.', href: '/nl/over-ons/team', more: 'Naar het team' },
        { title: 'Vacatures', text: 'Bouw mee aan AI-toepassingen, vanuit Groningen.', href: '/nl/vacatures', more: 'Naar de vacatures' },
        { title: 'AI Salon', text: 'Elke twee maanden de avond voor de AI-scene van het Noorden.', href: '/nl/ai-salon', more: 'Naar de AI Salon' },
        { title: 'Op tv en in de pers', text: 'AI Heroes in De AI Storm, en alles voor journalisten.', href: '/nl/pers', more: 'Voor de pers' },
      ]}
    />
  </HsSection>

  <HsContact />
</HsLayout>

<style>
  .about-story { max-width: 46rem; }
  .about-founders { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.75rem, 2vw, 2rem); max-width: 56rem; }
  .about-founders a { display: grid; gap: .5rem; text-decoration: none; }
  .about-founders__photo { aspect-ratio: 3 / 4; overflow: hidden; background: var(--dark); }
  .about-founders__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: contrast(1.05) url(#hs-duo-blue); transform: translateZ(0); backface-visibility: hidden; will-change: transform; transition: transform .6s var(--ease); }
  .about-founders a:hover img { transform: translateZ(0) scale(1.04); }
  .about-founders__name { font-weight: 700; font-size: clamp(1rem, .9rem + .4vw, 1.25rem); }
  .about-founders a:hover .about-founders__name { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: .25em; }
  .about-founders__role { font-size: .875rem; color: var(--body-on-light); }
</style>
