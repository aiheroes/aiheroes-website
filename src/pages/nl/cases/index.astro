---
import { getCollection } from 'astro:content';
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProofRow from '../../../components/blocks/ProofRow.astro';

const ENTRY_LABEL = { nieuw: 'Iets nieuws bouwen', vervangen: 'Vervangen wat niet meer voldoet', 'eigen-beheer': 'In eigen beheer draaien' } as const;
const ERA_LABEL = 'Eerdere case';

const items = (await getCollection('cases', (e) => e.data.lang === 'nl' && !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const cards = items.map((e) => ({
  title: e.data.client ?? e.data.title,
  eyebrow: e.data.era === 'eerder' ? ERA_LABEL : ENTRY_LABEL[e.data.entry],
  description: e.data.subtitle,
  href: `/nl/cases/${e.data.slug}`,
  accent: e.data.accentColor,
}));

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: items.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://aiheroes.io/nl/cases/${e.data.slug}`,
    name: e.data.client ?? e.data.title,
  })),
};
---

<SubpageLayout
  lang="nl"
  title="Cases"
  subtitle="Werk van het huidige team eerst: Kwakkel BV, INQ22, Strive en IC Commerce. Daarna de cases uit de tijd vóór de overname."
  seoTitle="Cases: software en AI die in productie draait"
  seoDescription="Bekijk wat AI Heroes bouwde: administratie-automatisering bij Kwakkel BV, een maatwerkwebwinkel voor INQ22, een SaaS-pakket vervangen bij Strive, e-commerce geautomatiseerd bij IC Commerce, en onze eigen Europees gehoste assistent."
  accentColor="red"
  jsonLd={listSchema}
>
  <section class="mb-12">
    <CardGrid items={cards} cols={2} />
  </section>
  <ProofRow label="Vertrouwd door" items={["Kwakkel BV", "INQ22", "Strive", "IC Commerce", "UMCG", "Tweede Kamer"]} />
</SubpageLayout>
