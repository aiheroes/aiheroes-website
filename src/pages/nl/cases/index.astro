---
// P16 Cases (docs/relaunch/pages/P16-cases.md): Strive featured, all cases as cards with a filter
// on entry (no sector filter), the homepage logo set and the contact block. Medux is named here
// (docs/relaunch/01-besluiten.md §7); a case with two entries shows under both filters.
import HsLayout from '../../../layouts/HsLayout.astro';
import HsPageCover from '../../../components/hs/HsPageCover.astro';
import HsSection from '../../../components/hs/HsSection.astro';
import HsCase from '../../../components/hs/HsCase.astro';
import HsCaseCards from '../../../components/hs/HsCaseCards.astro';
import HsContact from '../../../components/hs/HsContact.astro';
import { getCases, displayName, SECTOR_LABEL } from '../../../components/hs/cases';
import { ENTRIES, SITE, type Entry } from '../../../data/site';

const cases = await getCases();
const featured = cases.find((c) => c.data.featured) ?? cases[0];
const f = featured.data;

const LOGOS = [
  { name: 'UMCG', src: '/hs/logos-white/umcg.svg', h: 22 },
  { name: 'Tweede Kamer', src: '/hs/logos-white/tweede-kamer.svg', h: 36 },
  { name: 'Nationale Postcode Loterij', src: '/hs/logos-white/postcode-loterij.svg', h: 32 },
  { name: 'Envalior', src: '/hs/logos-white/envalior.svg', h: 34 },
  { name: 'Banijay Benelux', src: '/hs/logos-white/banijay.svg', h: 26 },
  { name: 'Prosus', src: '/hs/logos-white/prosus.svg', h: 42 },
  { name: 'Hanzehogeschool', src: '/hs/logos-white/hanze.svg', h: 30 },
];

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Cases van AI Heroes',
  itemListElement: cases.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://aiheroes.io/nl/cases/${c.data.slug}`,
    name: displayName(c, 'overview'),
  })),
};
const entryKeys = Object.keys(ENTRIES) as Entry[];
---

<HsLayout
  title="Cases"
  seoTitle="Cases: AI-toepassingen die elke dag gebruikt worden"
  description="Wat AI Heroes bouwde en wat het opleverde: Strive verving een ledenbeheerpakket en had de bouw in één jaar terugverdiend, Medux voert 4.000 gesprekken per maand voor 80% via AI, Kwakkel had in zes dagen een werkend prototype."
  crumbs={[{ label: 'Home', href: '/' }]}
  jsonLd={listSchema}
>
  <HsPageCover
    accent="red"
    crumbs={[{ label: 'Home', href: '/' }]}
    current="Cases"
    title="Wat we bouwden, en wat het *opleverde*"
    lede="Van een AI-stem die 4.000 gesprekken per maand voert tot een pakket dat in één jaar was terugverdiend. Kies een ingang, of bekijk alles."
    cta={{ label: 'Plan een startsprint', href: '#contact' }}
    secondary={{ label: 'Alle cases', href: '#alle-cases' }}
  />

  <HsCase
    id="uitgelicht"
    snap={false}
    photo={f.photo && !f.photo.shot ? { src: f.photo.src, alt: f.photo.alt, w: f.photo.w, h: f.photo.h, pos: f.photo.pos } : null}
    kicker={`Uitgelicht${SECTOR_LABEL[f.sector] ? ` · ${SECTOR_LABEL[f.sector]}` : ''}`}
    title={f.headline}
    lede={f.lede}
    stats={f.stats.map((s) => ({ value: s.value, decimals: s.decimals, suffix: s.suffix, label: s.label }))}
    close=""
    link={{ label: `Lees de case van ${displayName(featured, 'overview')}`, href: `/nl/cases/${f.slug}` }}
  />

  <HsSection id="alle-cases" title="Alle *cases*" lede="Een case kan bij meer dan één ingang horen. Kies er een om te filteren.">
    <div class="hs-filter" data-filter-group="case-list" role="group" aria-label="Filter op ingang" data-item>
      <button type="button" data-filter="all" aria-pressed="true">Alle cases</button>
      {entryKeys.map((k) => <button type="button" data-filter={k} aria-pressed="false">{ENTRIES[k].title}</button>)}
    </div>
    <HsCaseCards id="case-list" filterTags columns={3} />
  </HsSection>

  <HsSection tone="paper" title="Organisaties waar we mee *werkten*">
    <ul class="hs-logos hs-logos--light hs-logos--bare" data-item>
      {LOGOS.map((l) => <li><img src={l.src} alt={l.name} style={`--h:${l.h / 16}rem`} loading="lazy" decoding="async" /></li>)}
    </ul>
  </HsSection>

  <HsContact title="Lijkt jouw vraag hierop?" lede={`Plan een startsprint: in zes dagen weet je of het kan, wat het kost en hoe het eruitziet. Binnen ${SITE.reply} hoor je van ons.`} />
</HsLayout>

