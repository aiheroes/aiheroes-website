---
// C1–C9: one page per case from the caseStudies collection, in the case template
// (docs/relaunch/pages/C0-case-mal.md). The MDX body is the longer story.
import { getCollection, render } from 'astro:content';
import HsLayout from '../../../layouts/HsLayout.astro';
import HsCaseStudy from '../../../components/hs/HsCaseStudy.astro';
import { displayName, plainHeadline, SECTOR_LABEL } from '../../../components/hs/cases';

export async function getStaticPaths() {
  const items = await getCollection('caseStudies', (e) => e.data.lang === 'nl' && !e.data.draft);
  return items.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/nl/cases/${d.slug}`;
const named = !d.anonymous.page;
const sector = SECTOR_LABEL[d.sector];

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: plainHeadline(d.headline),
  description: d.lede,
  url: `https://aiheroes.io${path}`,
  inLanguage: 'nl',
  ...(sector ? { about: { '@type': 'Thing', name: sector } } : {}),
  ...(named ? { mentions: { '@type': 'Organization', name: d.client } } : {}),
  ...(d.year ? { datePublished: String(d.year) } : {}),
  author: { '@id': 'https://aiheroes.io/#organization' },
  publisher: { '@id': 'https://aiheroes.io/#organization' },
};
const review = d.quote?.approved
  ? {
      '@context': 'https://schema.org',
      '@type': 'Review',
      reviewBody: d.quote.text,
      author: { '@type': 'Person', name: d.quote.author },
      itemReviewed: { '@id': 'https://aiheroes.io/#organization' },
    }
  : null;
---

<HsLayout
  title={displayName(entry, 'page')}
  seoTitle={d.seoTitle ?? d.title}
  description={d.description}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Cases', href: '/nl/cases' }]}
  jsonLd={review ? [article, review] : [article]}
>
  <HsCaseStudy entry={entry}>
    <Content />
  </HsCaseStudy>
</HsLayout>
