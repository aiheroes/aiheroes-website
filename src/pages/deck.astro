---
import presentation from '../assets/deck/sme-pitch-v6.html?raw';

// Keep the exported deck intact, including its embedded assets and runtime.
// A standalone document avoids site styles, navigation and chat over the slides.
const html = presentation.replace('</head>', `
<meta name="description" content="AI Heroes presentation: practical bespoke software for small and medium businesses, from ambition to implementation.">
<meta name="robots" content="noindex, follow">
<link rel="canonical" href="https://aiheroes.io/deck">
</head>`);
---

<Fragment set:html={html} />
