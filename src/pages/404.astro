---
// H5 404 (docs/relaunch/pages/H5-404.md): the smallest hulp-template, with the full nav and footer
// (01-besluiten §15), the four main routes and the assistant as search. Noindex.
import HsLayout from '../layouts/HsLayout.astro';
import HsHelp from '../components/hs/HsHelp.astro';
import HsCards from '../components/hs/HsCards.astro';
import HsIcon from '../components/hs/HsIcon.astro';
import { SITE } from '../data/site';
---

<HsLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex>
  <!--
    Bare-path catch-all, kept from the old SPA BarePathRedirect: a prefix-less URL (/over-ons,
    /startsprint, /eigen-beheer, /about) is sent to its language-prefixed page in the browser. Slugs
    that only exist in one language decide the language; neutral slugs follow the visitor. Old slugs
    stay listed while vercel.json still redirects them.
  -->
  <script is:inline>
    (function () {
      var NL_ONLY = ['diensten','startsprint','software-vervangen','over-ons','aanpak','ai-geletterdheid','ai-strategie-gids','wat-kost-ai-implementatie','voorwaarden','vacatures','pers',
        'wat-we-bouwen','nieuwe-ai-toepassing','eigen-beheer','hoe-we-werken','kennis','ai-klantenservice','administratie-automatiseren','ai-integratie','extra-developers','maatwerk-software',
        'saas-vervangen','excel-vervangen','verouderde-software','ai-op-eigen-servers','europees-alternatief-chatgpt','ai-bureau-groningen','ai-bureau-nederland','ai-geletterdheid-training','digitale-soevereiniteit'];
      var EN_ONLY = ['services','start-sprint','replace-software','about','approach','ai-literacy','ai-strategy-guide','ai-implementation-costs','terms','careers','press',
        'what-we-build','new-ai-tool','self-hosted','how-we-work','insights'];
      function visitorLang() {
        try {
          var s = localStorage.getItem('aiheroes-lang');
          if (s === 'nl' || s === 'en') return s;
        } catch (e) {}
        var b = (navigator.language || '').toLowerCase();
        return b.indexOf('nl') === 0 ? 'nl' : 'en';
      }
      var segments = window.location.pathname.split('/').filter(Boolean);
      if (segments.length === 0) return;
      if (segments[0] === 'nl' || segments[0] === 'en') return; // already prefixed: a genuine 404
      var lang = null;
      for (var i = 0; i < segments.length; i++) {
        if (NL_ONLY.indexOf(segments[i]) !== -1) { lang = 'nl'; break; }
        if (EN_ONLY.indexOf(segments[i]) !== -1) { lang = 'en'; break; }
      }
      if (!lang) lang = visitorLang();
      window.location.replace('/' + lang + '/' + segments.join('/') + window.location.search + window.location.hash);
    })();
  </script>

  <HsHelp
    title="Deze pagina bestaat | niet *(meer)*"
    current="Niet gevonden"
    intro="De link is oud of er zit een typfout in. Kies hieronder waar je heen wilt, of vraag het de assistent."
    contact={`Kom je er niet uit? Mail [${SITE.email}](mailto:${SITE.email}) of bel ${SITE.phone}.`}
  >
    <HsCards
      variant="planes"
      columns={2}
      items={[
        { title: 'Wat we bouwen', href: '/nl/wat-we-bouwen', accent: 'red', text: 'Nieuwe AI-toepassingen, oude software vervangen en software in eigen beheer.', more: 'Bekijk wat we bouwen' },
        { title: 'De startsprint', href: '/nl/startsprint', accent: 'blue', text: `Zes dagen, vanaf ${SITE.sprint.price}, en je weet of het kan.`, more: 'Naar de startsprint' },
        { title: 'Cases', href: '/nl/cases', accent: 'dark', text: 'Wat we bouwden, met cijfers waar ze er zijn.', more: 'Bekijk de cases' },
        { title: 'Kennis', href: '/nl/kennis', accent: 'red', text: 'Artikelen en gidsen over de AI Act, kosten en waar je begint.', more: 'Naar kennis' },
      ]}
    />
    <p>
      <button class="hs-btn hs-btn--dark" type="button" data-open-chat>
        Vraag het de assistent
        <HsIcon name="arrow-right" />
      </button>
    </p>
  </HsHelp>
</HsLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-open-chat]').forEach((b) =>
      b.addEventListener('click', () => window.dispatchEvent(new Event('aih:open-chat'))),
    );
  });
</script>
