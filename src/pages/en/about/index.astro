---
// P11 About, English (docs/relaunch/pages/P11-over-ons.md, phase 7): mirrors /nl/over-ons. Who is
// behind AI Heroes. The takeover at the end of 2025 is told explicitly and the market story lives
// here; 50+ and 1,000+ always "since 2019"; no industry advisor.
import HsLayout from '../../../layouts/HsLayout.astro';
import HsPageCover from '../../../components/hs/HsPageCover.astro';
import HsSection from '../../../components/hs/HsSection.astro';
import HsCards from '../../../components/hs/HsCards.astro';
import HsPlace from '../../../components/hs/HsPlace.astro';
import HsContact from '../../../components/hs/HsContact.astro';
import HsIcon from '../../../components/hs/HsIcon.astro';
import { CONTENT } from '../../../data/content';
import { SITE_EN as S } from '../../../data/site';
import { FOUNDERS, FOUNDER_ORDER, founderText } from '../../../data/team';
import { zet } from '../../../components/hs/hs';

const crumbs = [{ label: 'Home', href: '/en' }];
const founders = FOUNDER_ORDER.map((id) => ({ ...FOUNDERS[id], ...founderText(id, 'en') }));
const LOGOS = [
  { name: 'UMCG', src: '/hs/logos-white/umcg.svg', h: 22 },
  { name: 'Tweede Kamer', src: '/hs/logos-white/tweede-kamer.svg', h: 36 },
  { name: 'Nationale Postcode Loterij', src: '/hs/logos-white/postcode-loterij.svg', h: 32 },
  { name: 'Envalior', src: '/hs/logos-white/envalior.svg', h: 34 },
  { name: 'Banijay Benelux', src: '/hs/logos-white/banijay.svg', h: 26 },
  { name: 'Prosus', src: '/hs/logos-white/prosus.svg', h: 42 },
  { name: 'Hanzehogeschool', src: '/hs/logos-white/hanze.svg', h: 30 },
];
const team = { ...CONTENT.en.team, cta: { text: 'AI agency in Groningen', href: '/en/ai-agency-groningen' } };
---

<HsLayout
  lang="en"
  title="About AI Heroes"
  seoTitle="About AI Heroes: building AI tools from Groningen"
  description="AI Heroes builds AI tools your team uses every day. A brand since 2019, taken over at the end of 2025 by Frans Hoorn, David Homan and Jan Brusse. From Groningen, on the Aarhusweg."
  crumbs={crumbs}
>
  <HsPageCover
    accent="red"
    crumbs={crumbs}
    current="About"
    title="About AI Heroes"
    lede="AI Heroes builds AI tools your team uses every day, for organisations that want more than a pilot. With a business case that adds up, compliance from the drawing board and a team that can work with it. From ambition to implementation."
    facts={[
      { value: S.proof.orgs, label: 'organisations helped since 2019' },
      { value: S.proof.trained, label: 'professionals trained since 2019' },
      { value: '6 days', label: 'from question to working prototype' },
    ]}
  />

  <HsSection title="A brand from 2019, | started *again*" lede="The name AI Heroes has existed since 2019. At the end of 2025, Frans Hoorn, David Homan and Jan Brusse took over the brand and the client relationships from the previous owner and started again.">
    <div class="hs-prose about-story" data-item>
      <p>{zet('Frans spent three years in the management of the original AI Heroes, David two years in its operations. AI Heroes B.V. was founded in Groningen on 1 May 2026. Since then we build from the Aarhusweg for organisations across the Netherlands and Europe.')}</p>
    </div>
  </HsSection>

  <HsSection tone="dark" title="Why AI Heroes *exists*" lede="The AI market is fragmented. Advisory firms write reports, training firms train and leave, tech companies build tools few people use.">
    <p class="hs-lead" data-item>{zet('We build what your team uses every day, and keep maintaining it.', { display: true })}</p>
  </HsSection>

  <HsSection title="What we *believe* in">
    <HsCards
      columns={4}
      items={[
        { icon: 'comments', title: 'Honesty over sales', text: 'If AI is not the answer, we say so. If the business case does not add up, we do not build.' },
        { icon: 'tool', title: 'Custom over standard', text: 'We build what fits your work, even when that is software without AI.' },
        { icon: 'code', title: 'We build ourselves', text: 'We advise and we build. Our own AI assistant runs on this site, hosted in Europe.', href: '/en/cases/eigen-stack', more: 'Read the case' },
        { icon: 'local', title: 'Groningen', text: 'Rooted in Groningen, where the AI Factory is coming. A local base and a European reach.' },
      ]}
    />
  </HsSection>

  <HsSection tone="paper" title="The three *founders*" lede="Each of them carries a part of the same track: the business case, the build and the training of your people.">
    <ul class="about-founders">
      {founders.map((f, i) => (
        <li data-item style={`--i:${i}`}>
          <a href="/en/about/team">
            <span class="about-founders__photo"><img src={f.photo} alt="" width="300" height="400" loading="lazy" decoding="async" /></span>
            <span class="about-founders__name">{f.name}</span>
            <span class="about-founders__role">{f.role}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="hs-sec__foot" data-item><a class="hs-link" href="/en/about/team">The team<HsIcon name="arrow-right" /></a></p>
  </HsSection>

  <HsPlace team={team} />

  <HsSection title="Organisations we *worked* with">
    <ul class="hs-logos hs-logos--light hs-logos--bare" data-item>
      {LOGOS.map((l) => <li><img src={l.src} alt={l.name} style={`--h:${l.h / 16}rem`} loading="lazy" decoding="async" /></li>)}
    </ul>
  </HsSection>

  <HsSection tone="paper" title="Read *on*">
    <HsCards
      columns={4}
      items={[
        { title: 'The team', text: 'Frans, David and Jan, and who to talk to about which question.', href: '/en/about/team', more: 'Meet the team' },
        { title: 'Careers', text: 'Build AI tools with us, from Groningen.', href: '/en/careers', more: 'See the vacancies' },
        { title: 'AI Salon', text: 'Every two months, the evening for the AI scene in the north of the Netherlands.', href: '/en/ai-salon', more: 'Go to the AI Salon' },
        { title: 'On TV and in the press', text: 'AI Heroes in De AI Storm, and everything for journalists.', href: '/en/press', more: 'Press' },
      ]}
    />
  </HsSection>

  <HsContact />
</HsLayout>

<style>
  .about-story { max-width: 46rem; }
  .about-founders { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.75rem, 2vw, 2rem); max-width: 56rem; }
  .about-founders a { display: grid; gap: .5rem; text-decoration: none; }
  .about-founders__photo { aspect-ratio: 3 / 4; overflow: hidden; background: var(--dark); }
  .about-founders__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: contrast(1.05) url(#hs-duo-blue); transform: translateZ(0); backface-visibility: hidden; will-change: transform; transition: transform .6s var(--ease); }
  .about-founders a:hover img { transform: translateZ(0) scale(1.04); }
  .about-founders__name { font-weight: 700; font-size: clamp(1rem, .9rem + .4vw, 1.25rem); }
  .about-founders a:hover .about-founders__name { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: .25em; }
  .about-founders__role { font-size: .875rem; color: var(--body-on-light); }
</style>
