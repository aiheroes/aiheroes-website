---
import { getCollection } from 'astro:content';
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProofRow from '../../../components/blocks/ProofRow.astro';

const ENTRY_LABEL = { nieuw: 'Build something new', vervangen: 'Replace what no longer fits', 'eigen-beheer': 'Run it on your own terms' } as const;
const ERA_LABEL = 'Earlier case';

const items = (await getCollection('cases', (e) => e.data.lang === 'en' && !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const cards = items.map((e) => ({
  title: e.data.client ?? e.data.title,
  eyebrow: e.data.era === 'eerder' ? ERA_LABEL : ENTRY_LABEL[e.data.entry],
  description: e.data.subtitle,
  href: `/en/cases/${e.data.slug}`,
  accent: e.data.accentColor,
}));

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: items.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://aiheroes.io/en/cases/${e.data.slug}`,
    name: e.data.client ?? e.data.title,
  })),
};
---

<SubpageLayout
  lang="en"
  title="Cases"
  subtitle="Work by the current team first: Kwakkel BV, INQ22, Strive and IC Commerce. Then the cases from before the takeover."
  seoTitle="Cases: software and AI that runs in production"
  seoDescription="See what AI Heroes built: administrative automation at Kwakkel BV, a custom web shop for INQ22, a SaaS package replaced at Strive, e-commerce automated at IC Commerce, and our own European-hosted assistant."
  accentColor="red"
  jsonLd={listSchema}
>
  <section class="mb-12">
    <CardGrid items={cards} cols={2} />
  </section>
  <ProofRow label="Trusted by" items={["Kwakkel BV", "INQ22", "Strive", "IC Commerce", "UMCG", "Tweede Kamer"]} />
</SubpageLayout>
