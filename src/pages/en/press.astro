---
// P14 Press (English): the press contact first (Jan Brusse), the boilerplate in three lengths, key
// facts, De AI Storm, the brand with the colour names of the deck template, and the press kit
// (docs/relaunch/01-besluiten.md §14). Mirrors /nl/pers.
import HsLayout from '../../layouts/HsLayout.astro';
import HsPageCover from '../../components/hs/HsPageCover.astro';
import HsSection from '../../components/hs/HsSection.astro';
import HsIcon from '../../components/hs/HsIcon.astro';
import HsLogo from '../../components/hs/HsLogo.astro';
import { SITE, SITE_EN } from '../../data/site';
import { FOUNDERS, FOUNDER_ORDER, founderText } from '../../data/team';
import { zet } from '../../components/hs/hs';

const crumbs = [{ label: 'Home', href: '/en' }, { label: 'About', href: '/en/about' }];
const press = FOUNDERS['jan-brusse'];
const a = SITE.address;

const BOILER = [
  { label: 'In one sentence', text: 'AI Heroes builds AI tools your team uses every day, from Groningen.' },
  { label: 'In one paragraph', text: 'AI Heroes builds AI tools your team uses every day, for organisations that want more than a pilot. We design, build and implement, and make sure it works: with a business case that adds up, compliance built in from day one and a team that can work with it. From Groningen, for all of Europe.' },
  { label: 'Longer', text: `AI Heroes builds AI tools your team uses every day, for organisations that want more than a pilot. We design, build and implement, and make sure it works: with a business case that adds up, compliance built in from day one and a team that can work with it. Clients come to us for a new AI tool, to replace old software or to run software they control themselves. Every build starts with the start sprint: six days, a fixed price, from ${SITE_EN.sprint.price}, with a working prototype or build plan and the business case on one page. The AI Heroes brand has existed since 2019 and has since helped more than 50 organisations and trained more than 1,000 professionals. At the end of 2025, Frans Hoorn, David Homan and Jan Brusse took over the brand and its client relationships. AI Heroes B.V. is based on the Aarhusweg in Groningen, where it also hosts AI Salon Groningen. From ambition to implementation.` },
];
const FACTS = [
  ['Registered name', SITE.legalName],
  ['Brand since', '2019; current team since the end of 2025'],
  ['Address', `${a.street}, ${a.postcode} ${a.city}, the Netherlands`],
  ['Chamber of Commerce', SITE.kvk],
  ['VAT', SITE.vat],
  ['Founders', 'Frans Hoorn, David Homan, Jan Brusse'],
];
const COLORS = [
  { name: 'Red', hex: '#D9534F', use: 'Accent and action' },
  { name: 'Blue', hex: '#2563EB', use: 'Accent and explanation' },
  { name: 'Dark', hex: '#1C1917', use: 'Text and dark planes' },
  { name: 'Light', hex: '#FDFCF8', use: 'Backgrounds and text on colour' },
];
const LOGO_FILES = [
  { label: 'Wordmark, colour (SVG)', href: '/Brand_Package/Logo/SVG/AIHeroes_Logo_FullColor_Transparent.svg' },
  { label: 'Wordmark, black (SVG)', href: '/Brand_Package/Logo/SVG/AIHeroes_Logo_Black_Transparent.svg' },
  { label: 'Wordmark, white (SVG)', href: '/Brand_Package/Logo/SVG/AIHeroes_Logo_White_Transparent.svg' },
  { label: 'Icon, colour (SVG)', href: '/Brand_Package/Icon/SVG/AIHeroes_Icon_FullColor_Transparent.svg' },
];
---

<HsLayout
  lang="en"
  title="Press"
  seoTitle="Press and media: AI Heroes"
  description={`AI Heroes for the press: press contact ${press.name}, the company description in three lengths, key facts, logos, colours and the press kit.`}
  crumbs={crumbs}
>
  <HsPageCover
    accent="dark"
    crumbs={crumbs}
    current="Press"
    title="For the *press*"
    lede={`Our press contact is ${press.name}, co-founder. Call +31 50 200 3373 or email ${SITE.email}. Below you will find the company description, the key facts and the press kit.`}
    cta={{ label: 'Email the press contact', href: `mailto:${SITE.email}?subject=${encodeURIComponent('Press enquiry')}` }}
    secondary={{ label: 'Download the press kit', href: '/pers/ai-heroes-perspakket.zip' }}
  />

  <HsSection title="AI Heroes in *brief*" lede="Free to quote as is. Pick the length that fits.">
    <div class="press-boiler">
      {BOILER.map((b, i) => (
        <figure data-item style={`--i:${i}`}>
          <figcaption>{b.label}</figcaption>
          <blockquote><p>{zet(b.text)}</p></blockquote>
          <button class="hs-link press-copy" type="button" data-copy={b.text} data-copied="Copied">Copy the text<HsIcon name="clipboard" /></button>
        </figure>
      ))}
    </div>
  </HsSection>

  <HsSection tone="paper" title="Key facts">
    <dl class="press-facts" data-item>
      {FACTS.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      <div><dt>Press contact</dt><dd>{press.name}, <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, <a href={SITE.phoneHref}>+31 50 200 3373</a></dd></div>
      <div><dt>Website</dt><dd><a href="/en">aiheroes.io</a></dd></div>
    </dl>
  </HsSection>

  <HsSection title="Recently in the *news*">
    <a class="press-news" href="/en/de-ai-storm" data-item>
      <img src="/broadcasters/ai-storm-wit.png" alt="De AI Storm" width="1250" height="250" loading="lazy" />
      <span class="press-news__date">First broadcast 7 June 2026 · RTL 7, RTL Z and Videoland</span>
      <span class="press-news__title">AI Heroes in De AI Storm</span>
      <span class="press-news__text">{zet('Jan Brusse talks about AI adoption in SMEs. Watch the episode, in Dutch.')}</span>
      <span class="hs-link">Watch the episode<HsIcon name="arrow-right" /></span>
    </a>
  </HsSection>

  <HsSection tone="paper" title="Logo and *brand*" lede="Our logo reads like a line diagram: the frame connects AI with HEROES, from ambition to implementation.">
    <div class="press-brand">
      <ul class="press-logos" data-item>
        <li class="is-light"><HsLogo mark="wordmark" /></li>
        <li class="on-dark"><HsLogo mark="wordmark" tone="white" /></li>
        <li class="on-red"><HsLogo mark="wordmark" tone="white" /></li>
        <li class="on-blue"><HsLogo mark="wordmark" tone="white" /></li>
      </ul>
      <ul class="press-files" data-item>
        {LOGO_FILES.map((f) => <li><a class="hs-link" href={f.href} download>{f.label}<HsIcon name="download" /></a></li>)}
      </ul>
      <p class="hs-body press-rules" data-item>{zet('Keep clear space around the logo of at least the height of the logo. Do not rotate, distort or recolour the logo. Minimum height: 32 pixels on screen, 10 millimetres in print.')}</p>
      <ul class="press-colors" data-item>
        {COLORS.map((c) => (
          <li>
            <span class="press-colors__swatch" style={`background:${c.hex}`}></span>
            <span class="press-colors__name">{c.name}</span>
            <span class="press-colors__hex">{c.hex}</span>
            <span class="press-colors__use">{c.use}</span>
          </li>
        ))}
      </ul>
      <p class="hs-body" data-item>Headings in Inter Tight, text in Inter.</p>
    </div>
  </HsSection>

  <HsSection tone="dark" title="The press *kit*" lede="Logos and icon in SVG and PNG and portraits of the founders, in one file.">
    <p class="hs-sec__foot" data-item>
      <a class="hs-btn hs-btn--light" href="/pers/ai-heroes-perspakket.zip" download>Download the press kit<HsIcon name="download" /></a>
    </p>
  </HsSection>

  <HsSection title="The *people*" lede="Want to interview someone? These are the founders. Jan Brusse appeared in De AI Storm.">
    <ul class="press-people" data-shuffle>
      {FOUNDER_ORDER.map((id, i) => {
        const f = FOUNDERS[id];
        return (
          <li data-item style={`--i:${i}`}>
            <a href={`/en/about/team#${f.id}`}>
              <span class="press-people__photo"><img src={f.photo} alt="" width="300" height="400" loading="lazy" decoding="async" /></span>
              <span class="press-people__name">{f.name}</span>
              <span class="press-people__role">{founderText(id, 'en').role}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </HsSection>
</HsLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
      const label = b.firstChild?.textContent ?? '';
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy ?? '');
          if (b.firstChild) b.firstChild.textContent = b.dataset.copied ?? 'Copied';
          setTimeout(() => { if (b.firstChild) b.firstChild.textContent = label; }, 2000);
        } catch { /* clipboard blocked: the text stays selectable */ }
      });
    });
  });
</script>

<style>
  .press-boiler { display: grid; gap: 2rem; max-width: 52rem; }
  .press-boiler figure { display: grid; gap: .75rem; padding-top: 1.25rem; box-shadow: inset 0 1.5px 0 var(--rule-on-light); }
  .press-boiler figcaption { font-size: .875rem; font-weight: 700; color: var(--red); }
  .press-boiler blockquote { font-size: clamp(1.0625rem, 1rem + .25vw, 1.25rem); line-height: 1.55; }
  .press-copy { justify-self: start; }

  .press-facts { display: grid; max-width: 52rem; }
  .press-facts div { display: grid; grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: 1rem; padding: .875rem 0; box-shadow: inset 0 -1.5px 0 var(--rule-on-light); }
  .press-facts dt { font-weight: 700; }
  .press-facts dd { color: var(--body-on-light); }
  .press-facts a { text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 559px) { .press-facts div { grid-template-columns: minmax(0, 1fr); gap: .25rem; } }

  .press-news { display: grid; gap: .75rem; max-width: 46rem; padding: clamp(1.5rem, 3vw, 2.5rem); background: var(--dark); color: var(--light); text-decoration: none; }
  .press-news img { height: 2.25rem; width: auto; margin-bottom: .75rem; }
  .press-news__date { font-size: .875rem; font-weight: 600; color: var(--micro-on-dark); }
  .press-news__title { font-weight: 800; letter-spacing: -0.02em; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.5rem); line-height: 1.1; }
  .press-news__text { color: var(--body-on-dark); }
  .press-news:hover .press-news__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .15em; }

  .press-brand { display: grid; gap: 2rem; }
  .press-logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; max-width: 52rem; }
  @media (min-width: 900px) { .press-logos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .press-logos li { display: grid; place-items: center; aspect-ratio: 3 / 2; padding: 1.5rem; }
  .press-logos li.is-light { background: var(--light); box-shadow: inset 0 0 0 1.5px var(--rule-on-light); }
  .press-logos :global(.hs-logo) { width: 84%; max-width: 13rem; }
  .press-files { display: flex; flex-wrap: wrap; gap: .75rem 2rem; }
  .press-rules { max-width: 52ch; color: var(--body-on-light); }
  .press-colors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; max-width: 52rem; }
  @media (min-width: 900px) { .press-colors { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .press-colors li { display: grid; gap: .25rem; align-content: start; min-width: 0; }
  .press-colors__swatch { display: block; width: 100%; height: clamp(5rem, 8vw, 7.5rem); box-shadow: inset 0 0 0 1.5px var(--rule-on-light); margin-bottom: .5rem; }
  .press-colors__name { font-weight: 700; }
  .press-colors__hex { font-size: .875rem; font-variant-numeric: tabular-nums; color: var(--body-on-light); }
  .press-colors__use { font-size: .875rem; color: var(--micro-on-light); }

  .press-people { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.75rem, 2vw, 2rem); max-width: 48rem; }
  .press-people a { display: grid; gap: .5rem; text-decoration: none; }
  .press-people__photo { aspect-ratio: 3 / 4; overflow: hidden; background: var(--dark); }
  .press-people__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: contrast(1.05) url(#hs-duo-blue); }
  .press-people__name { font-weight: 700; }
  .press-people a:hover .press-people__name { text-decoration: underline; text-underline-offset: .25em; }
  .press-people__role { font-size: .875rem; color: var(--body-on-light); }
</style>
