---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AISalonIsland from '../../components/islands/AISalonIsland';

const description =
  'AI Salon Groningen edition #2, Thursday November 5, 2026. A bimonthly community evening for AI founders, builders, investors, researchers and partners.';

// Editie #2 — datum + tijd bekend (5 nov, 18:00); de geplande locatie viel af, dus alleen de stad.
const edition2Schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'AI Salon Groningen · Edition #2',
  startDate: '2026-11-05T18:00:00+01:00',
  endDate: '2026-11-05T21:00:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Groningen',
    address: { '@type': 'PostalAddress', addressLocality: 'Groningen', addressCountry: 'NL' },
  },
  image: ['https://aiheroes.io/og-image.png'],
  description:
    'Second edition of AI Salon Groningen, Thursday 5 November 2026. Venue to be announced. Free community evening for AI founders, builders, investors, researchers and partners.',
  organizer: { '@type': 'Organization', name: 'AI Heroes', url: 'https://aiheroes.io' },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: 'https://luma.com/AI-Salon-Gro-2',
  },
};
---

<BaseLayout
  lang="en"
  title="AI Salon Groningen · Edition #2"
  description={description}
  jsonLd={[edition2Schema]}
  noChrome
>
  <AISalonIsland lang="en" client:load />
</BaseLayout>
