---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProcessSteps from '../../../components/blocks/ProcessSteps.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';

const offerings = [
  { id: 'ai-readiness-scan', title: 'AI Readiness Scan', accent: 'blue' as const, description: 'Where does your organisation stand with AI? We map maturity, data and culture and give you a concrete action plan. 1-3 days, from €3,000.' },
  { id: 'process-analysis', title: 'Process Optimisation', accent: 'blue' as const, description: 'A deep-dive into your business processes. Where are the automation opportunities, which bottlenecks can AI solve? You get a prioritised opportunity register. 3-5 days, from €5,000.' },
  { id: 'opportunity-scouting', title: 'Business Case Analysis', accent: 'red' as const, description: 'Where are you leaving money on the table? An organisation-wide scan of where AI delivers most, with an overview and the top 3-5 worked-out business cases. With a results guarantee.' },
  { id: 'business-case-development', title: 'Business Case Development', accent: 'red' as const, description: 'From a single AI opportunity to a substantiated investment proposal: ROI, cost estimates and a go/no-go. Board-ready. 1-2 weeks, from €5,000.' },
  { id: 'ai-roadmap', title: 'AI Roadmap', accent: 'blue' as const, description: 'From insight to implementation plan. A phased roadmap: quick wins, short and long term, including governance and resource planning. With us, one phase of a build; stand-alone is also possible, 2-4 weeks.' },
  { id: 'ai-implementation-guidance', title: 'Implementation Guidance', accent: 'red' as const, description: 'Hands-on guidance during rollout: change management, adoption tracking and coaching on the work floor. The bridge between plan and reality. 2-8 weeks.' },
];

const method = [
  { title: 'Intake and discovery', eyebrow: 'Kick-off', body: 'We start where you stand. Stakeholder interviews, a technical audit and an in-depth analysis of your processes, on-site or remote.' },
  { title: 'Analysis and prioritisation', eyebrow: 'The work', body: 'We map opportunities, quantify the impact and rank them on impact versus effort. Because we build AI ourselves, our cost estimates are realistic, not plucked from thin air.' },
  { title: 'Reporting and action plan', eyebrow: 'Delivery', body: 'A presentation of findings and a concrete action plan to your management or steering group. A plan that works, not a report that gathers dust. If the business case does not add up, we say so.' },
];

const stats = [
  { value: '1 page', label: 'business case before every build' },
  { value: '1 week', label: 'the start sprint, business case included' },
  { value: '70%', label: 'of AI projects fail without guidance' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Business case in one week', accent: 'red' as const, href: '/en/cases/kwakkel', description: 'Prototype on their own data plus the business case, in six days.' },
  { title: 'Strive', eyebrow: 'Business case before the replacement', accent: 'blue' as const, href: '/en/cases/strive', description: 'What the package cost, what custom software costs and when it pays back, before the build.' },
];

const related = [
  { title: 'The start sprint', accent: 'red' as const, href: '/en/start-sprint', description: 'One week, fixed price, a working prototype or build plan. Always with the business case included.' },
  { title: 'How we work', accent: 'blue' as const, href: '/en/about/approach', description: 'The project from business case to handover.' },
];

const faq = [
  { q: 'What does AI consulting cost?', a: 'A stand-alone readiness scan of 1 to 3 days starts from EUR 3,000; a process analysis or business case development from EUR 5,000. The start sprint (one week, from EUR 8,000) includes the business case for one concrete system. You know the cost up front; surprises afterwards are not part of the deal.' },
  { q: 'Where should my organisation start with AI?', a: 'If you already have a concrete process or system in mind, the start sprint is the first step: one week, a working prototype or build plan, business case included. If you do not yet know where to begin, the readiness scan maps in 1 to 3 days where you stand, which quick wins are available and what the logical next step is.' },
  { q: 'How long does it take from scan to roadmap?', a: 'On average 2 to 4 weeks. A stand-alone readiness scan is done in a few days; a full roadmap with substantiated business cases, governance and resource planning takes a few weeks. If it concerns one concrete system, the one-week start sprint is faster and more concrete.' },
  { q: 'What makes AI Heroes different from other consultancies?', a: 'We build ourselves. That makes our cost estimates realistic, and we also build what is in the business case. No handover to an external builder, no knowledge leak. And if the business case does not add up, we say so honestly and we do not build.' },
  { q: 'Do you also guide the implementation?', a: 'Yes. Around 70% of AI projects fail without guidance, so we do not stop at the report. With implementation guidance (2 to 8 weeks) we support the rollout on the work floor: change management, adoption tracking and coaching, until AI is part of the daily work.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI Consulting',
  serviceType: 'AI consulting',
  description: 'AI consulting from readiness scan and business case to roadmap and implementation guidance, for organisations across the Netherlands.',
  provider: { '@id': 'https://aiheroes.io/#organization' },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  availableLanguage: ['Dutch', 'English'],
  offers: { '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: '3000' },
  url: 'https://aiheroes.io/en/services/consulting',
};
---

<SubpageLayout
  lang="en"
  title="AI Consulting"
  subtitle="From first insight to working AI. We start where you stand, map the opportunities and deliver a plan that pays off, before you invest."
  seoTitle="AI consulting: business case, readiness scan and roadmap before the build"
  seoDescription="AI consulting that goes from readiness scan to business case, roadmap and implementation guidance. A plan that works, not a report that gathers dust. Realistic estimates, because we build ourselves."
  accentColor="blue"
  badge="Business case and scoping"
  trustedBy={["Kwakkel BV", "Strive", "UMCG", "Envalior", "050-IT"]}
  jsonLd={[serviceSchema, faqSchema]}
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Every build starts with a business case</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      Before we build, you know what it costs, what it returns and when it pays back. In the start sprint that business case is part of the outcome; this page describes how we make it, and what you can get from us if you first want to know where to begin.
    </p>
    <p class="text-stone-600 leading-relaxed">Because we build ourselves, our estimates are realistic. If the business case does not add up, we do not build, and we say so.</p>
    <StatGrid stats={stats} accent="blue" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">The journey, step by step</h2>
    <p class="text-stone-600 leading-relaxed mb-6">The start sprint includes the readiness scan and the business case for one concrete system. If you want to look wider or first want to know where to begin, these are the stand-alone components.</p>
    <CardGrid items={offerings} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">How we work</h2>
    <ProcessSteps steps={method} />
  </section>

  <section class="mb-16">
    <Callout variant="dark" accent="blue" eyebrow="Our promise" title="A plan that works, not a report that gathers dust">
      <p>Because we build AI ourselves, our cost estimates are realistic and not plucked from thin air. We advise honestly about what makes sense for your situation, and if the business case does not add up, we say so. The goal is an action plan that genuinely moves your organisation forward.</p>
    </Callout>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Business case in practice</h2>
    <CardGrid items={cases} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Frequently asked questions</h2>
    <div class="space-y-3">
      {faq.map((f) => (
        <details class="group border border-stone-200 bg-white">
          <summary class="cursor-pointer list-none p-5 font-medium text-brand-dark flex justify-between items-center gap-4">
            <span>{f.q}</span>
            <span class="text-stone-400 group-open:rotate-180 transition-transform flex-shrink-0">&#9662;</span>
          </summary>
          <div class="px-5 pb-5 text-sm text-stone-600 leading-relaxed">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">How this fits in a build</h2>
    <CardGrid items={related} cols={2} />
  </section>
</SubpageLayout>
