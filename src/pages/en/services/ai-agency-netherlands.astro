---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import { CONTENT } from '../../../data/content';

const entries = CONTENT.en.services.items.map((item, i) => ({
  title: item.title,
  eyebrow: item.tag,
  accent: (['red', 'blue', 'dark'] as const)[i],
  href: item.href,
  description: item.description,
}));

const stats = [
  { value: '50+', label: 'organisations helped' },
  { value: '6 days', label: 'from question to working prototype' },
  { value: '1,000+', label: 'professionals trained' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Build something new', accent: 'red' as const, href: '/en/cases/kwakkel', description: 'Automating the administration, prototype in six days.' },
  { title: 'INQ22', eyebrow: 'Build something new', accent: 'red' as const, href: '/en/cases/inq22', description: 'A custom web shop, live at inq22.com.' },
  { title: 'Strive', eyebrow: 'Replace what no longer fits', accent: 'blue' as const, href: '/en/cases/strive', description: 'An overpriced SaaS package replaced by custom software.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aiheroes.io/en' },
    { '@type': 'ListItem', position: 2, name: 'What we build', item: 'https://aiheroes.io/en/services' },
    { '@type': 'ListItem', position: 3, name: 'AI agency Netherlands', item: 'https://aiheroes.io/en/services/ai-agency-netherlands' },
  ],
};
---

<SubpageLayout
  lang="en"
  title="AI agency for the Netherlands"
  subtitle="Looking for an AI agency that builds? AI Heroes builds software and AI for organisations across the Netherlands and puts it into production. From Groningen."
  seoTitle="AI Agency Netherlands | Software and AI built for you, from prototype to production"
  seoDescription="Looking for an AI agency in the Netherlands? AI Heroes builds software and AI that runs in production, with business case, compliance and training included. Start sprint in one week, across the Netherlands, from Groningen."
  accentColor="blue"
  trustedBy={["Kwakkel BV", "INQ22", "Strive", "IC Commerce", "UMCG", "Tweede Kamer"]}
  jsonLd={breadcrumbSchema}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">An AI agency that builds</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      Most AI agencies advise or train. We build: software and AI that works on the day of delivery and keeps working, connected to your ERP, CRM and the rest of your landscape. The business case before it, the compliance inside it and the training of your team after it are part of every build. We call that the AI Heroes standard.
    </p>
    <p class="text-stone-600 leading-relaxed">For organisations with a concrete process, product or system, and an owner who can decide. Across the Netherlands, on-site and remote.</p>
    <StatGrid stats={stats} accent="blue" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Three ways in</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Choose the entry that fits your question.</p>
    <CardGrid items={entries} cols={3} />
  </section>

  <section class="mb-16">
    <Callout variant="dark" accent="red" eyebrow="The first step" title="The start sprint">
      <p>One week, fixed price from €8,000. At the end you know whether it can be done, what it costs and what it looks like: a working prototype or a build plan, always with the business case on one page. <a href="/en/start-sprint" class="text-white underline underline-offset-2 hover:no-underline">Read what the week looks like &rarr;</a></p>
    </Callout>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Results at Dutch organisations</h2>
    <CardGrid items={cases} cols={3} />
    <p class="mt-6 text-sm"><a href="/en/cases" class="text-brand-blue underline underline-offset-2 hover:no-underline">All cases &rarr;</a></p>
  </section>

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Across the Netherlands, based in Groningen</h2>
    <p class="text-stone-600 leading-relaxed">Our clients are spread across the country, from the Randstad to the north. We work on-site and remote. Our home base is <a href="/en/services/ai-agency-groningen" class="text-brand-blue underline underline-offset-2">Groningen, the AI capital of Europe</a>, with the AI Fabriek (AI Factory) and a growing ecosystem of AI talent on our doorstep.</p>
  </section>
</SubpageLayout>
