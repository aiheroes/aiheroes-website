---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProcessSteps from '../../../components/blocks/ProcessSteps.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import Faq from '../../../components/blocks/Faq.astro';

const options = [
  { id: 'on-premises', title: 'On your own servers', accent: 'dark' as const, description: 'A language model on your own hardware. No subscription, no data leaving the building. We install, configure and train your administrators; you keep the keys.' },
  { id: 'europese-cloud', title: 'European cloud', accent: 'blue' as const, description: 'Mistral in France, Aleph Alpha in Germany, Dutch hosting for the rest. Models of European standard, hosted under European law.' },
  { id: 'migratie', title: 'Migration away from US cloud', accent: 'red' as const, description: 'From ChatGPT, Azure OpenAI or AWS Bedrock to a European alternative, without your team noticing. Including procurement advice on suppliers and contracts.' },
  { id: 'ai-beleid', title: 'AI policy and AI Act', accent: 'red' as const, description: 'Classification of your systems under the AI Act, logging and human oversight in the design, and a two-page AI policy your team actually uses.' },
];

const method = [
  { title: 'Start sprint', eyebrow: 'Week 1', body: 'We map your digital environment: which tools, where data goes, which suppliers fall under US jurisdiction. Outcome: a hosting design, a risk assessment and the business case on one page.', href: '/en/start-sprint', hrefLabel: 'More about the start sprint' },
  { title: 'Build and migrate', eyebrow: 'Weeks 2 to 12', body: 'The model or the application runs in the chosen place, connected to your systems. Migration in phases, with the old and new environment side by side until the numbers match.' },
  { title: 'Management handed over', eyebrow: 'Delivery', body: 'Your administrators are trained, the documentation is complete and the AI Act classification is on record. You can keep it running yourself; we stay available if you want us to.' },
];

const stats = [
  { value: '1 week', label: 'to hosting design and risk assessment' },
  { value: 'EU law', label: 'on every server that touches your data' },
  { value: 'Own stack', label: 'our assistant on this site runs in Europe' },
];

const proof = [
  { title: 'The assistant on this site', eyebrow: 'Run it on your own terms', accent: 'dark' as const, href: '/en/cases/eigen-stack', description: 'Built by us, hosted in Europe, with a European database and retention policy. We do what we advise.' },
];

const related = [
  { title: 'Build something new', accent: 'red' as const, href: '/en/services/software', description: 'An assistant, a workflow, a tool that does not exist yet.' },
  { title: 'Replace what no longer fits', accent: 'blue' as const, href: '/en/services/replace-software', description: 'Outdated or overpriced software out, something that fits in its place.' },
];

const faq = [
  { q: 'Are European models good enough?', a: 'For most business applications, yes: summarising documents, answering questions on your own data, drafting texts, processing speech. In the start sprint we test it on your situation, so you do not have to take our word for it and can see for yourself.' },
  { q: 'What does a server of your own cost?', a: 'That depends on the model and the number of users. A medium-sized organisation runs a good language model on hardware of a few thousand euros, without a subscription. The comparison with cloud costs is in the business case from the start sprint.' },
  { q: 'Why would I want to move away from US cloud?', a: 'The CLOUD Act gives the US government access to data held by US companies, regardless of where the servers are. For governments, healthcare, law firms and organisations with procurement requirements around data sovereignty, that is a reason to do it differently. For others it is a trade-off; we advise honestly, including when the answer is that you are fine where you are.' },
  { q: 'What about the AI Act?', a: 'Since 2 August 2026, Dutch supervision has been operational. We classify your systems, build in logging and human oversight and make sure your team meets the literacy obligation of Article 4. That is part of every build; it is the AI Heroes standard.' },
  { q: 'Can I get advice only, without a build?', a: 'The start sprint delivers a hosting design and risk assessment you can take forward yourself, also without us. A standalone session on digital risks and European alternatives for your team is available too; you will find it under training.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Run it on your own terms: sovereign AI and hosting',
  serviceType: 'Sovereign AI implementation and European hosting',
  description: 'AI and software on your own servers or with a European provider. Local models, European cloud, migration away from US cloud, AI policy and AI Act classification.',
  provider: { '@id': 'https://aiheroes.io/#organization' },
  areaServed: { '@type': 'Place', name: 'European Union' },
  availableLanguage: ['Dutch', 'English'],
  offers: { '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: '8000' },
  url: 'https://aiheroes.io/en/services/eu-consultancy',
};
---

<SubpageLayout
  lang="en"
  title="Run it on your own terms"
  subtitle="AI and software on your own servers or with a European provider. No dependence on US cloud, with the AI Act built in."
  seoTitle="Sovereign AI: on your own servers or hosted in Europe, without US cloud"
  seoDescription="Run AI on your own terms with AI Heroes: local models on your own hardware, European cloud (Mistral, Aleph Alpha, Dutch hosting), migration away from US cloud, AI policy and AI Act classification. Start sprint in one week."
  accentColor="blue"
  badge="Run it on your own terms"
  entry="eigen-beheer"
  trustedBy={["UMCG", "Tweede Kamer", "Envalior", "050-IT"]}
  jsonLd={[serviceSchema, faqSchema]}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">“Can it run on our own servers? Our data may not leave Europe.”</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      For governments, healthcare, law firms and organisations with procurement requirements, this is a condition rather than a wish. We build AI that stays in Europe: on your own hardware or with a European provider, connected to your systems, with the AI Act in the design.
    </p>
    <p class="text-stone-600 leading-relaxed">We do it ourselves too. The assistant on this site was built by us and runs on European infrastructure.</p>
    <StatGrid stats={stats} accent="blue" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <Callout variant="red" accent="red" eyebrow="Why this matters" title="CLOUD Act and AI Act">
      <p>The US CLOUD Act gives the US government access to data stored with US companies, regardless of where the servers are. That applies to Microsoft, Google and Amazon, and therefore to ChatGPT, Azure OpenAI and AWS Bedrock.</p>
      <p>Since 2 August 2026, Dutch supervision of the EU AI Act has been operational. Anyone using AI systems must be able to classify, log and account for them, and must be able to show that staff are sufficiently AI-literate. In March 2025 the Tweede Kamer adopted motions on reducing dependence on US platforms; procurement is following.</p>
    </Callout>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">What we build</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Four forms, often in combination.</p>
    <CardGrid items={options} cols={2} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">How we start</h2>
    <ProcessSteps steps={method} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">We do what we advise</h2>
    <p class="text-stone-600 leading-relaxed mb-6">The proof we can show without client permission: our own stack.</p>
    <CardGrid items={proof} cols={2} />
  </section>

  <Faq items={faq} title="Frequently asked questions" class="mb-16" />

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">The other entries</h2>
    <CardGrid items={related} cols={2} />
  </section>
</SubpageLayout>
