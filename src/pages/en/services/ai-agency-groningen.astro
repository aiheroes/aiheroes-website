---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import Faq from '../../../components/blocks/Faq.astro';
import { PROFESSIONAL_SERVICE_SCHEMA } from '../../../data/schema';
import { CONTENT } from '../../../data/content';

const entries = CONTENT.en.services.items.map((item, i) => ({
  title: item.title,
  eyebrow: item.tag,
  accent: (['red', 'blue', 'dark'] as const)[i],
  href: item.href,
  description: item.description,
}));

const stats = [
  { value: '50+', label: 'organisations helped' },
  { value: '6 days', label: 'from question to working prototype' },
  { value: 'Aarhusweg', label: 'coffee is ready' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Build something new', accent: 'red' as const, href: '/en/cases/kwakkel', description: 'Automating the administration, prototype in six days.' },
  { title: 'Strive', eyebrow: 'Replace what no longer fits', accent: 'blue' as const, href: '/en/cases/strive', description: 'An overpriced SaaS package replaced by custom software.' },
  { title: 'Our own stack', eyebrow: 'Run it on your own terms', accent: 'dark' as const, href: '/en/cases/eigen-stack', description: 'The assistant on this site: hosted in Europe, with the AI Act built in.' },
];

const FAQ = [
  { q: 'What does an AI agency in Groningen do for my organisation?', a: 'AI Heroes builds software and AI and puts it into production. You come in with a concrete question: build something new, replace software or run AI on your own terms. The first step is always a one-week start sprint, with a working prototype or build plan and the business case included.' },
  { q: 'What does it cost?', a: 'The start sprint costs from EUR 8,000, fixed price, known up front. A custom build after that starts from EUR 15,000. Stand-alone trainings start from EUR 2,500 per day. What your build will cost exactly is on paper at the end of the start sprint.' },
  { q: 'Do you only work with companies in Groningen?', a: 'Our home base is Groningen and a large part of our clients are there, but we work across the Netherlands and Europe. For organisations in Groningen and the Northern Netherlands we are close by: dropping by is standard for us.' },
  { q: 'Do you also help with the EU AI Act?', a: 'Yes. Compliance is part of every build: we classify the system under the AI Act, build in logging and human oversight and train the team that works with it, so you meet Article 4. Since 2 August 2026 Dutch supervision has been operational.' },
  { q: 'How fast can we start?', a: 'We schedule a start sprint within two weeks. At the end of that week there is a working prototype or a build plan. At Kwakkel BV the prototype for the administration automation was ready after six days.' },
];

const PAGE_URL = 'https://aiheroes.io/en/services/ai-agency-groningen';

// Page-level org block replaces the sitewide one (BaseLayout detects ProfessionalService):
// same entity (@id), but scoped to this page URL with explicit local service area.
const localBusinessSchema = {
  ...PROFESSIONAL_SERVICE_SCHEMA,
  url: PAGE_URL,
  areaServed: [
    { '@type': 'City', name: 'Groningen' },
    { '@type': 'Place', name: 'Northern Netherlands' },
    { '@type': 'Place', name: 'European Union' },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aiheroes.io/en' },
    { '@type': 'ListItem', position: 2, name: 'What we build', item: 'https://aiheroes.io/en/services' },
    { '@type': 'ListItem', position: 3, name: 'AI agency Groningen', item: PAGE_URL },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<SubpageLayout
  lang="en"
  title="AI agency in Groningen"
  subtitle="Software and AI built for you in the AI capital of Europe. For organisations in Groningen, the Northern Netherlands and beyond."
  seoTitle="AI agency Groningen | Software and AI built for you"
  seoDescription="Looking for an AI agency in Groningen? AI Heroes at the Aarhusweg builds software and AI that runs in production, with business case, compliance and training included. Start sprint in one week."
  accentColor="red"
  trustedBy={["Kwakkel BV", "UMCG", "Hanze", "050-IT", "Tweede Kamer"]}
  jsonLd={[localBusinessSchema, breadcrumbSchema, faqSchema]}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">An AI agency in Groningen that builds</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      AI Heroes builds software and AI for organisations that want to go beyond a pilot, and puts it into production. If you are in Groningen or the Northern Netherlands, we are close by: we drop by, know the region and stay involved after delivery. A brand since 2019, with the current team since late 2025, we have helped more than 50 organisations, from SMEs in the north to the Dutch House of Representatives.
    </p>
    <StatGrid stats={stats} accent="red" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Three ways in</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Choose the entry that fits your question. The first step is always a <a href="/en/start-sprint" class="text-brand-red underline underline-offset-2 hover:no-underline">start sprint</a>.</p>
    <CardGrid items={entries} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">Groningen is the AI capital of Europe</h2>
    <p class="text-stone-600 leading-relaxed mb-4">
      If you take AI seriously, Groningen is a good place to be. With the AI Fabriek (AI Factory), EUR 200 million of AI compute and infrastructure is coming to the city. Around it grows an ecosystem of knowledge institutions, startups and established companies that apply AI in practice.
    </p>
    <p class="text-stone-600 leading-relaxed">
      AI Heroes sits in the middle of that ecosystem. We host the <a href="/en/ai-salon" class="text-brand-red underline underline-offset-2">AI Salon Groningen</a>, work with Hanze University of Applied Sciences and the UMCG, and build for Northern organisations such as Kwakkel BV and 050-IT.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">Results at clients</h2>
    <CardGrid items={cases} cols={3} />
  </section>

  <section class="mb-16">
    <Callout variant="light" accent="red" eyebrow="Visiting address" title="Aarhusweg 4-16, 9723 JJ Groningen">
      <p>AI Heroes B.V. Coffee is ready. Tell us at the bottom of this page what you want to build, or email <a href="mailto:hello@aiheroes.io" class="text-brand-red underline underline-offset-2">hello@aiheroes.io</a>.</p>
    </Callout>
  </section>

  <Faq items={FAQ} title="Frequently asked questions" />
</SubpageLayout>
