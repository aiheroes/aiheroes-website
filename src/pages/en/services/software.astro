---
import SubpageLayout from '../../../layouts/SubpageLayout.astro';
import CardGrid from '../../../components/blocks/CardGrid.astro';
import ProcessSteps from '../../../components/blocks/ProcessSteps.astro';
import StatGrid from '../../../components/blocks/StatGrid.astro';
import Callout from '../../../components/blocks/Callout.astro';
import Faq from '../../../components/blocks/Faq.astro';

const builds = [
  { id: 'assistenten', title: 'Assistants and voice AI', accent: 'red' as const, description: 'An assistant that answers questions from customers or staff based on your documents, or a phone line that handles the first question itself. With handover to a human and logging of every conversation.' },
  { id: 'werkstromen', title: 'Workflows and administration', accent: 'red' as const, description: 'Quotes, work orders, requests, invoices: the work that now goes through three systems by hand, processed automatically. Like the prototype for Kwakkel BV, in six days.' },
  { id: 'interne-tools', title: 'Internal tools and customer portals', accent: 'blue' as const, description: 'A planning system, a dashboard, a portal where customers manage their own affairs. Software that fits the way you work.' },
  { id: 'webapplicaties', title: 'Web applications and web shops', accent: 'blue' as const, description: 'Also without AI. INQ22 got a custom web shop that simply runs live. For us AI is a tool, never the goal in itself.' },
  { id: 'zoeken-en-documenten', title: 'Search and document processing', accent: 'dark' as const, description: 'Search all your documents with a plain question, read contracts and reports automatically, summaries that are correct. On your data, within your own walls if it has to be.' },
  { id: 'dedicated-teams', title: 'Extra build capacity', accent: 'dark' as const, description: 'If you have developers of your own, we strengthen your team with AI expertise: a tech lead and one to five developers, productive within a week.' },
];

const method = [
  { title: 'Start sprint', eyebrow: 'Week 1', body: 'One week, fixed fee. Intake, prototype on your data, demo and the business case on one page. Then you decide whether we continue.', href: '/en/start-sprint', hrefLabel: 'More about the start sprint' },
  { title: 'Build in sprints', eyebrow: 'Weeks 2 to 12', body: 'Short sprints with a demo at the end of each sprint, so you always see where we are. Compliance is in the design from the drawing board: AI Act classification, logging, human oversight and hosting.' },
  { title: 'In production and handed over', eyebrow: 'Delivery', body: 'The system runs, connected to your landscape. The team that works with it has been trained on it. Source code, documentation and data model are yours.' },
];

const stats = [
  { value: '6 days', label: 'from question to working prototype' },
  { value: 'From €15,000', label: 'for a custom build' },
  { value: 'No lock-in', label: 'source code and data model stay yours' },
];

const cases = [
  { title: 'Kwakkel BV', eyebrow: 'Build something new', accent: 'red' as const, href: '/en/cases/kwakkel', description: 'Automation of the administration. From question to working prototype in six days.' },
  { title: 'INQ22', eyebrow: 'Build something new', accent: 'blue' as const, href: '/en/cases/inq22', description: 'A custom web shop, live at inq22.com. Software without AI, built with AI.' },
];

const earlier = [
  { title: 'Medux', eyebrow: 'Earlier case', accent: 'dark' as const, href: '/en/cases/medux', description: 'Voice-to-voice AI customer service in healthcare.' },
  { title: 'Trabu', eyebrow: 'Earlier case', accent: 'dark' as const, href: '/en/cases/trabu', description: 'From idea to prototype for an investor round.' },
  { title: 'InnoEnergy', eyebrow: 'Earlier case', accent: 'dark' as const, href: '/en/cases/innoenergy', description: 'Prototype of an investment intelligence platform.' },
];

const related = [
  { title: 'Replace what no longer fits', accent: 'blue' as const, href: '/en/services/replace-software', description: 'Outdated or overpriced software out, something that fits in its place.' },
  { title: 'Run it on your own terms', accent: 'dark' as const, href: '/en/services/eu-consultancy', description: 'On your own servers or with a European provider, with the AI Act built in.' },
];

const faq = [
  { q: 'What does it cost to have software or AI built?', a: 'The start sprint costs from €8,000 and takes one week. A custom build after that starts from €15,000 and runs to well over €100,000 for large systems. At the end of the start sprint you know what your build costs, what it returns and when it pays back.' },
  { q: 'How fast is there something to see?', a: 'In the start sprint there is a working prototype on your data within a week. At Kwakkel BV the prototype for the administrative automation was there after six days. A production system follows in sprints of two weeks.' },
  { q: 'Do you also build software without AI?', a: 'Yes. INQ22 got a custom web shop that runs live. We build software; we use AI where it adds value and leave it out where it does not.' },
  { q: 'Do you work together with our own development team?', a: 'Yes, in three ways: we build independently, we strengthen your team with a tech lead and developers, or a hybrid of the two. Every delivery includes documentation and training, so your people can carry on independently.' },
  { q: 'How do you prevent vendor lock-in?', a: 'Open standards where possible, European hosting where it matters, and source code, documentation and a data model that are yours. You are never tied to a single supplier, including us.' },
  { q: 'What about the AI Act?', a: 'Compliance is part of the design: we classify the system under the AI Act, build in logging and human oversight, and choose hosting that fits your data. We train the team that works with it on the system; that means you meet Article 4 straight away.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Build something new: custom software and AI',
  serviceType: 'Custom software and AI development',
  description: 'Assistants, workflows, internal tools, customer portals, web applications and document processing. From prototype in six days to system in production, with business case, compliance and training included.',
  provider: { '@id': 'https://aiheroes.io/#organization' },
  areaServed: { '@type': 'Place', name: 'European Union' },
  availableLanguage: ['Dutch', 'English'],
  offers: { '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: '8000' },
  url: 'https://aiheroes.io/en/services/software',
};
---

<SubpageLayout
  lang="en"
  title="Build something new"
  subtitle="An assistant, a workflow or a tool you are missing today. From prototype in six days to system in production, built with your team and connected to your landscape."
  seoTitle="Have software and AI built: from prototype in 6 days to production"
  seoDescription="Have something new built by AI Heroes: assistants, workflows, internal tools, web applications and document processing. Start sprint in one week, custom builds from €15,000. Business case, compliance and training included."
  accentColor="red"
  badge="Build something new"
  entry="nieuw"
  trustedBy={["Kwakkel BV", "INQ22", "IC Commerce", "UMCG"]}
  jsonLd={[serviceSchema, faqSchema]}
  showStandard
>
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-4">“Can you build this for us?”</h2>
    <p class="text-lg text-stone-600 leading-relaxed mb-4">
      There is a process that takes too much manual work, an idea for an assistant, a tool the team has been missing for years. We build it: first a prototype on your data in one week, then on in sprints until it runs in production.
    </p>
    <p class="text-stone-600 leading-relaxed">With AI where it adds value, and without it where it does not. For organisations that know what they want to build and have an owner who can decide.</p>
    <StatGrid stats={stats} accent="red" cols={3} class="mt-8" />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">What we build</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Six kinds of work we do often. If yours is not on the list, the start sprint is the way to find out whether it can be done.</p>
    <CardGrid items={builds} cols={3} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">How we start</h2>
    <ProcessSteps steps={method} />
  </section>

  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-2">Where we have proved it</h2>
    <p class="text-stone-600 leading-relaxed mb-6">Work by the current team.</p>
    <CardGrid items={cases} cols={2} />
    <h3 class="font-serif text-xl text-brand-dark mt-10 mb-4">Earlier cases</h3>
    <p class="text-sm text-stone-500 mb-4">Work from the period before the acquisition at the end of 2025, which brought the AI Heroes brand name with it.</p>
    <CardGrid items={earlier} cols={3} />
  </section>

  <section class="mb-16">
    <Callout variant="light" accent="blue" eyebrow="Handover" title="Without lock-in">
      <p>We work with open standards where possible and European hosting where it matters. Source code, documentation and data model are yours. You can carry on without us if you want to.</p>
    </Callout>
  </section>

  <Faq items={faq} title="Frequently asked questions" class="mb-16" />

  <section>
    <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-6">The other entries</h2>
    <CardGrid items={related} cols={2} />
  </section>
</SubpageLayout>
