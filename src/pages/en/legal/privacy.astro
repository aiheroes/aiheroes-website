---
// H1 Privacy (English), in the help template: a faithful translation of /nl/legal/privacy (no
// newsletter, processors in general terms, the AI-policy template row). Approved by Frans with the
// Dutch text on 2026-10-12 (01-besluiten §17). 2026-10: website visits, the consent bar, Google
// Analytics and the PHP check added (marketing-automation SDD §8 and §11, phase 1).
import HsLayout from '../../../layouts/HsLayout.astro';
import HsHelp from '../../../components/hs/HsHelp.astro';
import { SITE } from '../../../data/site';

const crumbs = [{ label: 'Home', href: '/en' }];
const rows = [
  { what: 'Contact form', data: 'Name, email address, organisation, your choices in the form and your message', why: 'Getting back to you about your question', where: 'Our email service, mailbox and our customer system in the EU', how: 'Up to two years after the last contact' },
  { what: 'Job application', data: 'Name, email address, phone number, motivation and CV', why: 'Assessing your application', where: 'Our mailbox; we do not store the CV anywhere else', how: 'Up to four weeks after the procedure ends, or longer if you give your consent' },
  { what: 'AI assistant', data: 'Your questions and the answers, pseudonymised: without name, IP address or profile', why: 'Running and improving the assistant', where: 'In the EU', how: 'At most 30 days' },
  { what: 'Contact through the assistant', data: 'Name and email address, only if you ask for contact yourself', why: 'Passing your question to the team and replying', where: 'In the EU, also in our customer system', how: 'In the chat at most 90 days; in our customer system up to two years after the last contact' },
  { what: 'Booking an introduction', data: 'Name, email address and the time you choose', why: 'Making and keeping the appointment', where: 'Our calendar service', how: 'Up to two years after the last contact' },
  { what: 'AI policy template download', data: 'Email address', why: 'Sending you the template and, if you wish, contacting you about your AI policy', where: 'Our email service, mailbox and our customer system in the EU', how: 'Up to two years after the last contact' },
  { what: 'Visiting the website', data: 'Which pages you view and for how long, where you came from (such as a search engine or LinkedIn), your country and the kind of device. Without a cookie and without your IP address: your visit gets a code that changes every day.', why: 'Understanding how the site is used', where: 'In the EU', how: 'Individual visits 90 days, after that only daily counts' },
  { what: 'Visiting the website with your consent', data: 'A random code in a cookie, so we recognise you on a next visit. If you later leave your details, we link your earlier visits to them.', why: 'Seeing which topics interest you, so we can help you better', where: 'In the EU', how: '13 months, or until you withdraw your choice. Once linked to your details: up to two years after the last contact' },
  { what: 'Google Analytics', data: 'Measurement data without a cookie. With your consent Google also sets a cookie, so returning visits count as one visitor.', why: 'Statistics on visits and campaigns', where: 'Google, also in the US (under the EU-US Data Privacy Framework)', how: '14 months' },
  { what: 'PHP version check', data: 'The address you enter and the result of the check', why: 'Seeing how the check is used. If your organisation is already known to us, we see that you ran the check', where: 'In the EU', how: '13 months' },
];
---

<HsLayout
  lang="en"
  title="Privacy statement"
  seoTitle="Privacy statement AI Heroes"
  description="How AI Heroes handles your data: what we process, why, where and for how long, and how to exercise your rights."
  crumbs={crumbs}
>
  <HsHelp
    title="Privacy statement"
    intro="What we do with your data, why, where and for how long."
    updated="October 2026"
    crumbs={crumbs}
    summary={[
      'We only collect what is needed for the purpose you give it for.',
      'We do not sell your data and do not share it for commercial purposes.',
      'We process as much as possible within the EU.',
      'You can always ask to see, correct or delete your data.',
      'We comply with the GDPR.',
    ]}
    toc={[
      { id: 'processing', label: 'What we process' },
      { id: 'cookies', label: 'Cookies and your choice' },
      { id: 'processors', label: 'Who helps us' },
      { id: 'assistant', label: 'The AI assistant' },
      { id: 'rights', label: 'Your rights' },
      { id: 'controller', label: 'Controller' },
    ]}
    contact={`Questions about your privacy, or want to exercise one of your rights? Email [${SITE.email}](mailto:${SITE.email}) or call +31 50 200 3373.`}
    related={[{ label: 'About our AI assistant', href: '/en/legal/ai-assistant' }, { label: 'Terms and conditions', href: '/en/legal/terms' }]}
  >
    <div class="hs-prose">
      <p>At AI Heroes we take privacy seriously. We only collect the data we need, keep it no longer than necessary and never share it with third parties for commercial purposes.</p>

      <h2 id="processing">What we process</h2>
      <p>Per situation: which data, what for, where it is stored and how long we keep it.</p>
    </div>
    <div class="hs-table-wrap">
      <table class="hs-table">
        <thead><tr><th scope="col">Situation</th><th scope="col">Data</th><th scope="col">Purpose</th><th scope="col">Where</th><th scope="col">How long</th></tr></thead>
        <tbody>
          {rows.map((r) => <tr><th scope="row">{r.what}</th><td>{r.data}</td><td>{r.why}</td><td>{r.where}</td><td>{r.how}</td></tr>)}
        </tbody>
      </table>
    </div>
    <div class="hs-prose">
      <p>We do not use third-party cookies for advertising and do not track you across other sites.</p>

      <h2 id="cookies">Cookies and your choice</h2>
      <p>On your first visit we ask whether we may remember your visit. We keep your choice in the cookie <code>aih_consent</code>, so we do not ask again on every page. If you say yes, we also set the cookie <code>aih_vid</code> with a random code, and Google Analytics sets its cookies (<code>_ga</code>). If you say no, we set no other cookies and measure your visit without recognising you. Google Analytics then only receives measurement data without a cookie. All these cookies expire after 13 months at most. You can change your choice with the Privacy choice button at the bottom of every page.</p>

      <h2 id="processors">Who helps us</h2>
      <p>For part of the work we use service providers: our hosting providers, our email service, the service behind the AI assistant, our calendar service, the party we use to handle registrations for the AI Salon and Google Analytics for statistics on website visits. We make agreements with them about the processing of your data. Where possible, processing takes place within the EU. Our email service sends from the EU, but may store delivery data outside the EU. Google may process measurement data in the US; this falls under the EU-US Data Privacy Framework.</p>

      <h2 id="assistant">The AI assistant on this site</h2>
      <p>On aiheroes.io you can chat with our AI assistant. Your chat history is stored in your own browser. On our servers we keep conversations pseudonymised, without name, IP address or profile, to improve the assistant, for at most 30 days. Only if you ask for contact with the team yourself and leave your name and email address do we process personal data. We use it only to reply and keep it for at most 90 days. You can read more about the assistant on <a href="/en/legal/ai-assistant">this page</a>.</p>

      <h2 id="rights">Your rights</h2>
      <p>Under the GDPR you have these rights:</p>
      <ul>
        <li><strong>Access:</strong> you can ask which data we hold about you.</li>
        <li><strong>Rectification:</strong> you can have incorrect data corrected.</li>
        <li><strong>Erasure:</strong> you can ask us to delete your data.</li>
        <li><strong>Objection:</strong> you can object to certain processing.</li>
      </ul>
      <p>You can also file a complaint with the Dutch Data Protection Authority (Autoriteit Persoonsgegevens). We would rather hear it from you first, so we can put it right.</p>

      <h2 id="controller">Controller</h2>
      <p>{SITE.legalName}, {SITE.address.street}, {SITE.address.postcode} {SITE.address.city}, the Netherlands, is the controller of the personal data in this statement. Chamber of Commerce number {SITE.kvk}, VAT number {SITE.vat}. We are subject to Dutch and European privacy law.</p>
    </div>
  </HsHelp>
</HsLayout>
