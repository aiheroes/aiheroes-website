---
// P7 The start sprint, English (docs/relaunch/pages/P7-startsprint.md, phase 7): the front door.
// Six days, from €8,000 for all three entries, start within two weeks (docs/relaunch/01-besluiten.md §1).
import HsLayout from '../../layouts/HsLayout.astro';
import HsPageCover from '../../components/hs/HsPageCover.astro';
import HsSection from '../../components/hs/HsSection.astro';
import HsCards from '../../components/hs/HsCards.astro';
import HsSteps from '../../components/hs/HsSteps.astro';
import HsCase from '../../components/hs/HsCase.astro';
import HsFit from '../../components/hs/HsFit.astro';
import HsFaq from '../../components/hs/HsFaq.astro';
import HsContact from '../../components/hs/HsContact.astro';
import { SITE, SITE_EN, ENTRIES_EN } from '../../data/site';
import { serviceSchema, faqSchema } from '../../data/schema';

const s = SITE_EN.sprint;
const crumbs = [{ label: 'Home', href: '/en' }, { label: 'How we work', href: '/en/how-we-work' }];

const outcomes = [
  { title: ENTRIES_EN.nieuw.title, accent: 'red' as const, href: ENTRIES_EN.nieuw.href, more: 'More about new AI tools', text: 'A working prototype on your own data. Your team tries it out before anyone decides to build.' },
  { title: ENTRIES_EN.vervangen.title, accent: 'blue' as const, href: ENTRIES_EN.vervangen.href, more: 'More about replacing software', text: 'An architecture and a migration plan: what is new, what stays and in which order you switch over.' },
  { title: ENTRIES_EN['eigen-beheer'].title, accent: 'dark' as const, href: ENTRIES_EN['eigen-beheer'].href, more: 'More about self-hosted AI', text: 'A hosting design and a risk assessment: where it runs, who has access and what the AI Act asks.' },
];

const days = [
  { label: 'Day 1', title: 'Intake and scope', text: 'We sit down with the owner and the people who do the work. Together we decide what should be there on day six.', meta: 'From you: the owner and two or three users, half a day.' },
  { label: 'Days 2 and 3', title: 'Build or design', text: 'We build the prototype, or we design the new architecture or the hosting.', meta: 'From you: someone for questions, an hour a day.' },
  { label: 'Day 4', title: 'Connect to your real data', text: 'The prototype starts running on your own data and systems, next to the current work.', meta: 'From you: someone who knows your data and systems, a few hours.' },
  { label: 'Day 5', title: 'Test with users', text: 'Your people work with it. Whatever gets in their way, we fix the same day.', meta: 'From you: the users, an hour.' },
  { label: 'Day 6', title: 'Demo, business case and decision', text: 'We show what is there, with the business case on a single page. You decide: build, adjust or stop.', meta: 'From you: the owner, an hour.' },
];

const faq = [
  { q: 'What does a start sprint cost?', a: `A fixed price, from ${s.price}, for all three ways in. The price is fixed before we start.` },
  { q: 'How soon can we start?', a: `Within ${s.startWithin} of the first call. After your request you hear from us within ${SITE_EN.reply}, usually with a proposal.` },
  { q: 'What do we need to free up?', a: 'The owner on day 1 and day 6, a few users for the intake and the test, and a few hours from someone who knows your data and systems. We do the building.' },
  { q: 'What if it does not work in six days?', a: 'Then you know after six days, and you know why. Sometimes a question turns out bigger than expected; the plan then says what it takes. If AI is not the answer, we say so.' },
  { q: 'Is the price different per way in?', a: `No. From ${s.price} for all three: a new AI tool, replacing old software or self-hosted AI.` },
  { q: 'Can we skip the start sprint?', a: 'Almost never. The start sprint keeps us from building something whose business case does not add up. Only if you are looking for [extra developers in your team](/en/extra-developers) do we start with an introduction.' },
  { q: 'Does it work for software without AI?', a: 'Yes. We build what you need, with or without AI. The [INQ22](/en/cases/inq22) web shop has no AI in it, yet we built it with AI.' },
  { q: 'What happens after the start sprint?', a: `If the build goes ahead, the start sprint is phase 1. We build in two-week sprints, from ${SITE_EN.build.from}, and after delivery we keep maintaining and developing the system. If it does not go ahead, you keep the prototype or plan and the business case.` },
];
---

<HsLayout
  lang="en"
  title="The start sprint"
  seoTitle="The start sprint: a working AI prototype or build plan in six days"
  description={`The AI Heroes start sprint: six days, fixed price, from ${s.price}, start within two weeks. A working prototype or build plan with the business case on a single page.`}
  crumbs={crumbs}
  jsonLd={[
    serviceSchema({ name: 'Start sprint', path: '/en/start-sprint', price: SITE.sprint.priceValue, serviceType: 'AI prototype and business case', description: `Six days, fixed price, from ${s.price}: a working prototype or build plan with the business case on a single page.` }),
    faqSchema(faq),
  ]}
>
  <HsPageCover
    accent="red"
    crumbs={crumbs}
    current="The start sprint"
    title="Six days. A fixed price. | Then you *know*."
    lede="The start sprint is the first step of every build. At the end of day six you know whether it can be done, what it costs and what it looks like."
    cta={{ label: 'Plan a start sprint', href: '#contact' }}
    secondary={{ label: 'See the six days', href: '#six-days' }}
    facts={[
      { value: '6 days', label: 'from question to prototype or build plan' },
      { value: s.price, label: 'fixed price, for every way in' },
      { value: '2 weeks', label: 'after the first call you can start' },
    ]}
  />

  <HsSection title="What you have *in hand* after six days" lede="What is on the table on day six depends on your question. It always comes with the business case on a single page: what the build costs, what it returns and when it pays for itself." split>
    <HsCards variant="planes" items={outcomes} />
  </HsSection>

  <HsSection id="six-days" tone="paper" title="Six days, *day by day*" lede="We do the work. From your side, a few people for a few hours a day.">
    <HsSteps items={days} />
  </HsSection>

  <HsCase
    id="example"
    snap={false}
    kicker="Example"
    title="From question to | working prototype | in six days"
    lede="Kwakkel BV wanted to see whether the manual admin work could go, and did not want to take a report's word for it. After six days a prototype was running on their own administration, with the business case on a single page."
    stats={[{ value: 6, label: 'days from question to working prototype' }]}
    close="Whatever the system is unsure about, it puts to a staff member. Kwakkel keeps the prototype, the plan and the business case, and decides when the build starts."
    link={{ label: 'Read the case', href: '/en/cases/kwakkel' }}
    photo={{ src: '/hs/photos/cover-office.webp', w: 1800, h: 1200, pos: '55% 50%' }}
  />

  <HsSection title="And *after* that">
    <HsCards
      columns={2}
      items={[
        { icon: 'check', title: 'If the build goes ahead', text: `Then the start sprint is phase 1. We build in two-week sprints, from ${SITE_EN.build.from}, with a demo after every sprint. After delivery we keep maintaining and developing the system.`, href: '/en/how-we-work', more: 'How we work' },
        { icon: 'close', title: 'If the business case does not add up', text: 'Then we do not build. You keep the prototype or the plan and the business case. An honest decision after six days saves you a project nobody uses.', href: '/en/business-case', more: 'Cost and return up front' },
      ]}
    />
  </HsSection>

  <HsSection tone="paper" title="Is this *for you*?">
    <HsFit
      yes={{ title: 'Yes, if you', items: ['have a process, system or idea that costs money or holds back growth', 'have someone who can decide on the build', 'can free up a few hours of your own people over six days'] }}
      no={{ title: 'Not yet, if you', items: ['first want to know where AI pays off in your organisation: start with [cost and return up front](/en/business-case)', 'mainly want your team to learn to work with AI: see [AI training for your team](/en/training)'] }}
    />
  </HsSection>

  <HsSection title="Frequently asked *questions*">
    <HsFaq items={faq} />
  </HsSection>

  <HsContact title="Plan your start sprint" lede={`Tell us what you want to build. You hear from us within ${SITE_EN.reply}, usually with a proposal for your start sprint.`} />
</HsLayout>
