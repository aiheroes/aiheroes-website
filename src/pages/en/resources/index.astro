---
import { getCollection } from 'astro:content';
import SubpageLayout from '../../../layouts/SubpageLayout.astro';

// Fixed editorial order for the index; anything not listed follows, newest first.
const ORDER = [
  'ai-implementation-costs',
  'eu-ai-act-compliance',
  'ai-literacy',
  'sovereign-ai',
  'european-chatgpt-alternatives',
  'ai-implementation-sme',
  'ai-policy-guide',
  'ai-strategy-guide',
  'top-10-ai-consultancy-netherlands',
];
const rank = (slug: string) => {
  const i = ORDER.indexOf(slug);
  return i === -1 ? ORDER.length : i;
};
const articles = (await getCollection('articles', (e) => e.data.lang === 'en' && !e.data.draft))
  .sort((a, b) => rank(a.data.slug) - rank(b.data.slug) || b.data.publishDate.getTime() - a.data.publishDate.getTime());

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---

<SubpageLayout
  lang="en"
  title="Resources"
  subtitle="Insights, practical guides and AI know-how for organisations across the Netherlands."
  seoTitle="Resources: guides on AI costs, the AI Act and sovereign AI"
  seoDescription="Practical guides from AI Heroes on what AI implementation costs, the EU AI Act and sovereign AI. Written by people who build themselves."
  accentColor="blue"
>
  <div class="grid md:grid-cols-2 gap-6 not-prose">
    {articles.map((a) => (
      <a href={`/en/resources/${a.data.slug}`} class="group block p-6 bg-white border border-stone-200 hover:border-brand-blue transition-colors">
        <p class="text-xs uppercase tracking-wider text-stone-400 mb-2">{fmt(a.data.publishDate)}</p>
        <h2 class="text-xl font-serif text-brand-dark mb-2 group-hover:text-brand-blue transition-colors">{a.data.title}</h2>
        <p class="text-stone-600 text-sm leading-relaxed">{a.data.description}</p>
      </a>
    ))}
  </div>
</SubpageLayout>
