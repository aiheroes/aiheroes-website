---
// A content section of a subpage: a heading (one punch word with *asterisks*), an optional lede and
// the content in the slot. Tones follow the four colours; red and blue stay rare (Two Fields Rule).
import { display, rich } from './hs';

interface Props {
  id?: string;
  tone?: 'light' | 'paper' | 'dark' | 'blue' | 'red';
  title?: string;
  lede?: string;
  /** Heading beside the lede on wide screens. */
  split?: boolean;
  /** Smaller heading for sections deep in a page. */
  size?: 'm' | 's';
  /** Heading level for nested pages. */
  level?: 2 | 3;
  class?: string;
}
const { id, tone = 'light', title, lede, split = false, size = 's', level = 2, class: cls } = Astro.props;
const toneClass = tone === 'dark' ? 'on-dark' : tone === 'blue' ? 'on-blue' : tone === 'red' ? 'on-red' : `hs-sec--${tone}`;
const H = level === 2 ? 'h2' : 'h3';
---

<section class:list={['hs-sec', toneClass, cls]} id={id} data-reveal>
  <div class="hs-wrap">
    {(title || lede) && (
      <div class:list={['hs-sec__head', { 'is-split': split && lede }]}>
        {title && <H class={size === 'm' ? 'hs-d-m' : 'hs-d-s'} data-item set:html={display(title)} />}
        {lede && <p class="hs-body-l" data-item style="--i:1" set:html={rich(lede)} />}
      </div>
    )}
    <slot />
  </div>
</section>
