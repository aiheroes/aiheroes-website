---
// The application form in the house style. Posts multipart (with the CV) to /api/apply, which mails
// the team through Resend; same fields and bot checks as the old React form. "Open sollicitatie" is
// one of the choices (01-besluiten §13).
import HsIcon from './HsIcon.astro';
import { JOBS } from '../../data/jobs';

interface Props {
  /** Preselected position title; empty means open application. */
  position?: string;
  title?: string;
  id?: string;
}
const { position = '', title = 'Solliciteer', id = 'solliciteer' } = Astro.props;
const OPEN = 'Open sollicitatie';
---

<div class="hs-apply" id={id}>
  <h2 class="hs-d-s">{title}</h2>
  <form class="hs-form" data-hs-apply method="post" action="/api/apply" enctype="multipart/form-data" novalidate>
    <input class="hs-honey" type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="hs-form__row">
      <label class="hs-field">
        <span class="hs-label">Naam</span>
        <input class="hs-input" type="text" name="name" autocomplete="name" required />
      </label>
      <label class="hs-field">
        <span class="hs-label">E-mail</span>
        <input class="hs-input" type="email" name="email" autocomplete="email" required />
      </label>
      <label class="hs-field">
        <span class="hs-label">Telefoon</span>
        <input class="hs-input" type="tel" name="phone" autocomplete="tel" />
      </label>
    </div>
    <fieldset>
      <legend>Vacature</legend>
      <div class="hs-chips">
        {JOBS.map((j) => (
          <label class="hs-chip"><input type="radio" name="position" value={j.title} checked={position === j.title} /><span>{j.title}</span></label>
        ))}
        <label class="hs-chip"><input type="radio" name="position" value={OPEN} checked={!position} /><span>{OPEN}</span></label>
      </div>
    </fieldset>
    <label class="hs-field">
      <span class="hs-label">Motivatie</span>
      <textarea class="hs-input" name="motivation" rows="5" required placeholder="Waarom AI Heroes, en wat wil je bijdragen?"></textarea>
    </label>
    <label class="hs-field">
      <span class="hs-label">Cv (pdf of docx, maximaal 8 MB)</span>
      <input class="hs-input hs-apply__file" type="file" name="cv" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
    </label>
    <label class="hs-apply__consent">
      <input type="checkbox" name="consent" required />
      <span>Ik ga akkoord met de verwerking van mijn gegevens voor deze sollicitatie, volgens de <a href="/nl/legal/privacy">privacyverklaring</a>.</span>
    </label>
    <div class="hs-form__foot">
      <p class="hs-form__status" role="status" aria-live="polite"></p>
      <button class="hs-btn hs-btn--dark" type="submit">
        Verstuur sollicitatie
        <HsIcon name="arrow-right" />
      </button>
    </div>
  </form>
</div>

<script>
  const MAX = 8 * 1024 * 1024;
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLFormElement>('[data-hs-apply]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      const opened = Date.now();
      const status = form.querySelector<HTMLElement>('.hs-form__status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const say = (t: string, state: string) => { if (status) { status.textContent = t; status.dataset.state = state; } };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const missing = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')]
          .find((f) => (f instanceof HTMLInputElement && f.type === 'checkbox' ? !f.checked : !f.value.trim()));
        if (missing) {
          say(missing.getAttribute('type') === 'checkbox' ? 'Geef toestemming voor de verwerking van je gegevens.' : 'Vul je naam, e-mailadres en motivatie in.', 'error');
          missing.focus();
          return;
        }
        const email = form.querySelector<HTMLInputElement>('input[type="email"]');
        if (email && !email.checkValidity()) { say('Dat e-mailadres klopt nog niet helemaal.', 'error'); email.focus(); return; }
        const file = form.querySelector<HTMLInputElement>('input[type="file"]')?.files?.[0];
        if (file && file.size > MAX) { say('Je cv is te groot. Maximaal 8 MB.', 'error'); return; }
        const data = new FormData(form);
        const done = () => { form.reset(); say('Ontvangen. We bevestigen je sollicitatie binnen twee werkdagen.', 'ok'); };
        const bot = !!data.get('bot-field') || Date.now() - opened < 3000;
        if (bot) { done(); return; }
        data.delete('consent');
        say('Bezig met versturen…', 'busy');
        if (button) button.disabled = true;
        try {
          const res = await fetch(form.action, { method: 'POST', body: data });
          if (res.ok) done();
          else if (res.status === 413) say('Je cv is te groot. Maximaal 8 MB.', 'error');
          else if (res.status === 415) say('Stuur je cv als pdf of docx.', 'error');
          else say('Er ging iets mis. Probeer het opnieuw of mail ons via info@aiheroes.io.', 'error');
        } catch {
          say('Er ging iets mis. Probeer het opnieuw of mail ons via info@aiheroes.io.', 'error');
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  });
</script>

<style>
  .hs-apply { display: grid; gap: 2rem; max-width: 47.5rem; }
  .hs-apply__file { padding: .75rem 1rem; }
  .hs-apply__file::file-selector-button { margin-right: 1rem; padding: .5rem .875rem; border: 0; border-radius: 2px; background: var(--dark); color: var(--light); font: 600 .9375rem/1 var(--font); cursor: pointer; }
  .hs-apply__consent { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .75rem; align-items: start; font-size: .9375rem; color: var(--body-on-light); }
  .hs-apply__consent input { width: 1.125rem; height: 1.125rem; margin-top: .15em; accent-color: var(--dark); }
  .hs-apply__consent a { text-decoration: underline; text-underline-offset: .2em; }
</style>
