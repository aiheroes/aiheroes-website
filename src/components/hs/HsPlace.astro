---
// L09 photo slide. Groningen is a real place, so the photo stays in colour (deck §10).
import HsIcon from './HsIcon.astro';
import { zet } from './hs';
import type { Content } from '../../data/types';

interface Props {
  team: Content['team'];
}
const { team } = Astro.props;
---

<section class="hs-place hs-snap" id="groningen" data-reveal>
  <div class="hs-place__photo">
    <img src={team.image.src} alt={team.image.alt} width="1200" height="1500" loading="lazy" decoding="async" />
  </div>
  <div class="hs-place__text">
    <h2 class="hs-d-m" data-item>{zet(team.title, { display: true })}</h2>
    <p class="hs-body-l hs-place__claim" data-item style="--i:1">{zet(team.location, { display: true })}</p>
    <p class="hs-body" data-item style="--i:2">{zet(team.body)}</p>
    <a class="hs-link" href={team.cta.href} data-item style="--i:3">
      {team.cta.text}
      <HsIcon name="arrow-right" />
    </a>
  </div>
</section>
