---
// Cream slide; the three entries are one strip of colour fields (post "merkkaart"), the only
// colour in the section, with their text below.
import HsIcon from './HsIcon.astro';
import { zet } from './hs';
import type { Content } from '../../data/types';

interface Props {
  services: Content['services'];
}
const { services } = Astro.props;
const FIELDS = ['on-red', 'on-blue', 'on-dark'];
// Experiment copy: the same names as the sub-menu, so menu and page say the same thing
// (constants.ts stays as it is for the live homepage).
const TITLES: Record<string, string> = {
  'Iets nieuws bouwen': 'Nieuwe AI-toepassing',
  'Vervangen wat niet meer voldoet': 'Oude software vervangen',
  'In eigen beheer draaien': 'Software op je eigen servers',
};
---

<section class="hs-entries hs-snap" id="wat-we-bouwen" data-reveal>
  <div class="hs-wrap hs-entries__head">
    <h2 class="hs-d-m" data-item>{zet(services.title, { display: true })}</h2>
  </div>
  <div class="hs-wrap hs-entries__row">
    {services.items.map((item, i) => (
      <a class="hs-entry" href={item.href} style={`--i:${i}`}>
        <div class:list={['hs-entry__plane', FIELDS[i % FIELDS.length]]}>
          <h3 class="hs-entry__title">{zet(TITLES[item.title] ?? item.title, { display: true, cap: 12 })}</h3>
          <HsIcon name="arrow-up-right" />
        </div>
        <div class="hs-entry__text">
          <p class="hs-body" data-item style={`--i:${i + 3}`}>{zet(item.description, { cap: 28 })}</p>
          <span class="hs-entry__more" data-item style={`--i:${i + 4}`}>
            <span>{services.cta}</span>
            <HsIcon name="arrow-right" />
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
