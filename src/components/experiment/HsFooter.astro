---
// The closing slide: dark band and the light square with the logo, echoing the cover.
import HsLogo from './HsLogo.astro';
import { zet } from './hs';
import type { Content } from '../../data/types';

interface Props {
  footer: Content['footer'];
  nav: Content['nav'];
}
const { footer, nav } = Astro.props;
const [company, , knowledge] = nav.about.columns ?? [];
const cols = [
  { heading: footer.columns.build, items: nav.build.children ?? [] },
  { heading: footer.columns.how, items: nav.how.children ?? [] },
  { heading: footer.columns.company, items: [...(company?.items ?? []), { label: nav.cases.label, href: nav.cases.href }] },
  { heading: footer.columns.knowledge, items: knowledge?.items ?? [] },
];
---

<footer class="hs-footer on-dark">
  <div class="hs-footer__body">
    <p class="hs-footer__tagline">{zet(footer.tagline)}</p>
    <nav class="hs-footer__cols" aria-label="Footer">
      {cols.map((c) => (
        <div>
          <h3>{c.heading}</h3>
          <ul>
            {c.items.map((i) => <li><a href={i.href}>{zet(i.label, { display: true, cap: 22 })}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
    <div class="hs-footer__legal hs-micro">
      <span>{footer.copyright}</span>
      <span>{zet("AI Heroes B.V.", { cap: 30 })} · {zet("Aarhusweg 4-16,")} {zet("9723 JJ Groningen", { cap: 30 })} · {zet("KvK 42051968")}</span>
      <a href="/nl/legal/privacy">{footer.legal.privacy}</a>
      <a href="/nl/legal/voorwaarden">{footer.legal.terms}</a>
      <span>{zet(footer.madeIn)}</span>
    </div>
  </div>
  <div class="hs-footer__square">
    <HsLogo mark="wordmark" />
  </div>
</footer>
