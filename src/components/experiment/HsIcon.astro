---
import { ICONS, type IconName } from './hs';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg class:list={['hs-icon', cls]} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {ICONS[name].map((d) => <path d={d} pathLength="1" />)}
</svg>
