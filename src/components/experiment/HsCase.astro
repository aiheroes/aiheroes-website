---
// The work in numbers (post "klantcase"): the voice-AI customer service case, with the figures from
// src/content/cases/nl/medux.mdx. The client is not named on the homepage: it works with another
// partner now (2026-10-07), so the case stands anonymously and without a link to the named case
// page. The result is phrased without a tense, since we do not know whether the system still
// runs. The photo is an Unsplash stand-in: a smiling support employee with headphones at a laptop
// (duotone: people).
import { zet } from './hs';

// The 80% and the 4.000 calls a month carry the heading; the figures row holds the other two.
const STATS = [
  { value: 70, suffix: '%', decimals: 0, label: 'kostenbesparing' },
  { value: 7.8, suffix: '', decimals: 1, label: 'klanttevredenheid' },
];
const fmt = (s: (typeof STATS)[number]) => s.value.toFixed(s.decimals).replace('.', ',') + s.suffix;
---

<section class="hs-case on-dark hs-snap" id="case" data-reveal>
  <div class="hs-case__photo">
    <img src="/experiment/photos/case-support.webp" alt="" width="1400" height="788" loading="lazy" decoding="async" />
  </div>
  <div class="hs-case__text">
    <p class="hs-case__kicker" data-item>Case</p>
    <h2 class="hs-d-m" data-item style="--i:1">{zet('4.000 gesprekken per maand, | 80% door AI', { display: true })}</h2>
    <p class="hs-body-l hs-case__lede" data-item style="--i:2">
      {zet('Voor een Nederlandse zorgorganisatie met klanten die liever bellen dan online iets regelen, bouwden we een AI-stem die kan opnemen, afspraken inplannen en vragen beantwoorden.', { cap: 40 })}
    </p>
    <dl class="hs-stats" data-item style={`--i:3;--n:${STATS.length};--fig-w:${Math.max(...STATS.map((s) => fmt(s).length)) + 0.4}ch`}>
      {STATS.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd data-count={s.value} data-decimals={s.decimals} data-suffix={s.suffix}>{fmt(s)}</dd>
        </div>
      ))}
    </dl>
    <p class="hs-body" data-item style="--i:4">
      {zet('Ook buiten kantooruren, met doorschakeling naar een medewerker bij lastige of dringende vragen.')}
    </p>
  </div>
</section>
