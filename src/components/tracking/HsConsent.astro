---
// Consent bar for layer 1 of the visit tracking (marketing-automation SDD §8.1 and §11, decision
// B23): "Ja" is the prominent button, "Liever niet" stays on the same bar as a text button. The
// bar never blocks the page. The logic is in consent.ts; the footer reopens it via
// [data-consent-open]. Changing the copy means bumping CONSENT_VERSION in consent.ts.
import type { Lang } from '../../data/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const COPY = {
  nl: {
    label: 'Privacykeuze',
    title: 'Mogen we je bezoek onthouden?',
    body: "Dan herkennen we je bij een volgend bezoek. Vraag je later een scan of gesprek aan, dan zien we welke pagina's je las en kunnen we je gerichter helpen. Google Analytics zet dan ook een cookie. Kies je nee, dan meten we je bezoek zonder cookies en zonder je te herkennen.",
    more: 'Meer in de privacyverklaring',
    href: '/nl/legal/privacy#cookies',
    yes: 'Ja, prima',
    no: 'Liever niet',
  },
  en: {
    label: 'Privacy choice',
    title: 'Can we remember your visit?',
    body: 'Then we recognise you on your next visit. If you later ask for a scan or a call, we see which pages you read and can help you better. Google Analytics then also sets a cookie. If you say no, we measure your visit without cookies and without recognising you.',
    more: 'More in our privacy statement',
    href: '/en/legal/privacy#cookies',
    yes: 'Yes, fine',
    no: 'No thanks',
  },
}[lang];
---

<section class="hs-consent on-dark" data-consent hidden aria-label={COPY.label}>
  <p class="hs-consent__title">{COPY.title}</p>
  <p class="hs-consent__body">{COPY.body} <a href={COPY.href}>{COPY.more}</a></p>
  <div class="hs-consent__actions">
    <button type="button" class="hs-btn hs-btn--light hs-btn--s" data-consent-choice="yes">{COPY.yes}</button>
    <button type="button" class="hs-consent__no" data-consent-choice="no">{COPY.no}</button>
  </div>
</section>

<style is:global>
  .hs-consent {
    position: fixed;
    left: 1.25rem;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    z-index: 95;
    display: grid;
    gap: .75rem;
    width: min(34rem, calc(100vw - 2.5rem));
    padding: 1.25rem 1.5rem 1.5rem;
    background: var(--dark);
    color: var(--light);
    box-shadow: 0 0 0 1.5px var(--rule-on-dark);
    font-family: var(--font);
  }
  .hs-consent[hidden] { display: none; }
  .hs-consent__title { font-weight: 700; font-size: 1.125rem; line-height: 1.25; letter-spacing: -.01em; }
  .hs-consent__body { font-size: .9375rem; line-height: 1.5; color: var(--body-on-dark); }
  .hs-consent__body a { color: var(--light); text-underline-offset: .2em; }
  .hs-consent__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; margin-top: .25rem; }
  .hs-consent__no {
    font: 500 .9375rem/1.3 var(--font);
    color: var(--body-on-dark);
    text-decoration: underline;
    text-underline-offset: .25em;
    background: none;
    border: 0;
    padding: .5rem 0;
    cursor: pointer;
  }
  .hs-consent__no:hover { color: var(--light); }
  .hs-consent :is(button, a):focus-visible { outline: 2px solid var(--light); outline-offset: 3px; }
  /* Phones: the full width, above the chat launcher in the bottom-right corner. */
  @media (max-width: 639px) {
    .hs-consent { left: .75rem; width: calc(100vw - 1.5rem); bottom: calc(5rem + env(safe-area-inset-bottom)); padding: 1rem 1.125rem 1.25rem; }
  }
  .hs-footer__consent {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .hs-footer__consent:hover { color: var(--light); text-decoration: underline; text-underline-offset: .25em; }
</style>

<script>
  import './consent';
</script>
