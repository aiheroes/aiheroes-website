---
/**
 * "Bij elke bouw inbegrepen": the four things every build includes, as a band
 * for static pages. Copy comes from CONTENT[lang].standard so the homepage and
 * every subpage say exactly the same thing.
 */
import { CONTENT } from '../../data/content';
import type { Lang } from '../../data/i18n';

interface Props {
  lang: Lang;
  /** Anchor id, so "Hoe we werken" can deep-link to it. */
  id?: string;
  class?: string;
}
const { lang, id = 'standaard', class: className = '' } = Astro.props;
const c = CONTENT[lang].standard;
---
<section id={id} class={`bg-white border border-stone-200 p-6 md:p-10 scroll-mt-28 ${className}`}>
  <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mb-1">{c.title}</h2>
  <p class="text-stone-600 mb-8">{c.subtitle}</p>
  <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {c.items.map((item, i) => (
      <li class="border-t-2 border-stone-200 pt-4">
        <span class="block font-serif text-2xl text-stone-300 mb-2">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="font-bold text-brand-dark mb-1">{item.title}</h3>
        <p class="text-sm text-stone-600 leading-relaxed">{item.description}</p>
      </li>
    ))}
  </ol>
</section>
